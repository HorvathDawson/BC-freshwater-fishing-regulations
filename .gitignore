# Environment variables with API keys
.env
.env.local
.env.*.local
# `output/` was RETIRED — everything it held now lives under data/generated/, which
# data/.gitignore ignores. Deliberately NOT ignored any more: if a tool recreates output/,
# it should show up in `git status` and be fixed, not vanish quietly the way six phantom
# output/pipeline/* directories did.
**/node_modules

# Vite build cache / dep pre-bundling
**/.vite/

# Python virtual environments
.venv/
venv/
# (T978) a worktree LINKS the main checkout's .venv / cache (deploy/lib/build-links.sh prints the `ln -s`): a link is a
# file, which the directory patterns above and `cache/` do not match
/.venv
/cache

# Wrangler local state (Miniflare R2, seed stamps)
**/.wrangler/
.seed-stamp
**/.seed-stamp

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Local Claude Code tooling — not part of the project
.claude/
CLAUDE.md
.rtk/
graphify-out/
# app workspace
app/**/node_modules/
app/**/dist/
app/**/*.tsbuildinfo

# scratch work-lists and audit dumps (regenerated by pipeline/tools)
scratch_*.json
# (T777) a test's own folder that must sit inside the repo (the step-cache tracer skips the temp dir); removed by the test
/.test-scratch/


# Playwright MCP scratch (screenshots, snapshots, console logs from browser sessions)
.playwright-mcp/

# tools/curation-review frontend build output (vite build) — built locally, never committed
tools/curation-review/frontend/dist/

# TypeScript incremental build cache
*.tsbuildinfo

# PSF run-timing pages: fetched, never committed (owner 2026-11-05: in git only the parsed timing.json; PSF grants no reuse, T162)
data/source/runtiming/*.html
data/source/runtiming/fetched.json

# (T1041) the ledger and owner VIEWS, built from each ticket's row and `## Owner` block by `node app/tools/ledger.mjs` (the
# post-checkout and post-merge hooks run it): a committed view would conflict on every merge, which is what they ended
docs/views/
