@@ -0,0 +1,462 @@
+"""RUN TIMING ON THE MAP (T162): which salmon and steelhead runs are on each section, and when — the release file `runs`.
+
+    python -m pipeline.deliver runs --bundle FILE --out FILE [--build DIR] [--tiles DIR]   (a step of `deliver all`)
+
+Reads the parsed timings (`data/curated/runtiming/timing.json`, `pipeline.runtiming.timing`), the CU polygons
+(`GENERATED.runtiming/cu_polygons.geojson`, from `pipeline.runtiming.parse`), the atlas graph (`graph.pkl`: the flow
+walk and the watershed codes) and the TILES' OWN section geometry (`layers/stream.geojsonl`, `lake.geojsonl`: the
+shapes the map colours, as `bundle/access.py` reads them). Bound against THIS atlas at every delivery, so the file can
+never outlive the section ids it names (the old frozen index did: section ids moved under it).
+
+THREE RELATIONS, never merged (a sheet says which; the map draws local runs solid and passing runs on a paler ramp):
+  spawning   PSF: the section's midpoint lies in the run's Conservation Unit polygon, and the section is a stream of
+             Strahler order `MIN_ORDER` or more, or a lake with an outflow. A CU is a whole watershed and the curve is
+             the CU's, not each creek's: painting every first-order trickle and pond in it (509k and 189k of the 948k
+             sections the unfiltered join bound, 2026-10-24) claimed a run in each, and cost 2 MB gzipped.
+  passage    PSF: the section is on the way from the CU to the sea — the flow graph walked DOWN from the CU's
+             spawning sections, never into another drainage (the FWA code of every step must be an ancestor of a
+             spawning section's: the tidal reaches below one river join the next river's), and a CU's sections in a
+             foreign drainage (a polygon simplified across a divide) are dropped first as spill
+             (`SPILL_SHARE` / `SPILL_MIN` / `SPILL_KEEP`, measured on the 2026-09-08 index: real multi-drainage CUs hold
+             >= 1 % in their smallest root, the spill 1–13 sections).
+  observed   DFO: the stream a NuSEDS survey site is on (its FWA watershed code), the sections of that code that carry
+             the site's name (`observed`: a slough's site on its river's code binds nothing) — on a long water (over
+             `LONG_WATER_KM`) only those within `NEAR_SITE_KM` of the site. Where a section is
+             observed for a slot, that slot's PSF `spawning` runs are dropped there (owner 2026-10-24: DFO where it is
+             better); its passing runs stay. Of several sites on one section, per slot and run label, the nearest one.
+
+PSF dates are RIVER ENTRY: no travel time is invented. Each section with a PSF run carries `km` (river km to the sea,
+the graph's lengths summed down its own blue line, `km_to_sea`) so the sheet can say how far up the reader stands.
+
+THE FILE (`runs/1`), little-endian, varints LEB128:
+    magic    b"BCRN", version u8 = 1, handles 8 bytes (the bundle's `meta.section_handles`)
+    header   varint length + UTF-8 JSON: {slots, sources, runs: [{s, sp, slot, n, l, pk, w, q, y}],
+             profiles: [[run_ix * 3 + relation, …], …]}
+    curves   len(runs) × 73 bytes: each run's curve, 0..100 (pipeline/runtiming/timing.py)
+    count    varint: sections listed
+    then per section, ascending sid: sid delta varint, profile varint, TENS of km to the sea + 1 varint (0: no PSF
+             run here; tens, because the sheet says "about 120 km", and one byte holds that to 1,270 km)
+A section the file does not list has no run recorded: absence is the claim, and the app says "no run recorded", never
+"no fish".
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import pickle
+from collections import Counter, defaultdict, deque
+from pathlib import Path
+from typing import Dict, Iterable, Iterator, List, Mapping, Optional, Sequence, Set, Tuple
+
+from pipeline.deliver.binary import read_varint, varint
+from pipeline.runtiming.timing import PENTADS, SLOTS, Timing, TimedRun
+
+FORMAT = "runs/1"
+MAGIC = b"BCRN"
+VERSION = 1
+SPAWNING, PASSAGE, OBSERVED = 0, 1, 2
+RELATIONS = ("spawning", "passage", "observed")
+SIMPLIFY = 0.001            # ~70 m, on top of the ~200 m the Explorer's z8 tiles already carry
+MIN_ORDER = 3
+SPILL_SHARE, SPILL_MIN, SPILL_KEEP = 0.01, 5, 100
+LONG_WATER_KM = 150.0
+NEAR_SITE_KM = 50.0
+#: the tile layers whose sections take a run (wetlands do not: a run is in a stream or a lake)
+LAYERS = ("stream", "lake")
+
+
+# ---- geometry, cheaply ---------------------------------------------------------------------------------------------
+
+def _line_mid(coords: Sequence[Sequence[float]]) -> Tuple[float, float]:
+    """The point half way ALONG a line (planar degrees: a section is a few km, the error is metres)."""
+    if len(coords) == 1:
+        return coords[0][0], coords[0][1]
+    seg = [math.hypot(b[0] - a[0], b[1] - a[1]) for a, b in zip(coords, coords[1:])]
+    half, acc = sum(seg) / 2, 0.0
+    for (a, b), d in zip(zip(coords, coords[1:]), seg):
+        if acc + d >= half and d > 0:
+            t = (half - acc) / d
+            return a[0] + t * (b[0] - a[0]), a[1] + t * (b[1] - a[1])
+        acc += d
+    return coords[-1][0], coords[-1][1]
+
+
+def point_of(geom: dict) -> Optional[Tuple[float, float]]:
+    """A point for a tile feature: a line's midpoint (the longest part of a multi-line), a polygon's ring centre."""
+    t, c = geom.get("type"), geom.get("coordinates")
+    if not c:
+        return None
+    if t == "LineString":
+        return _line_mid(c)
+    if t == "MultiLineString":
+        return _line_mid(max(c, key=len))
+    if t == "Polygon":
+        ring = c[0]
+    elif t == "MultiPolygon":
+        ring = max((p[0] for p in c), key=len)
+    else:
+        return None
+    return sum(p[0] for p in ring) / len(ring), sum(p[1] for p in ring) / len(ring)
+
+
+def section_points(layers: Path) -> Iterator[Tuple[int, float, float]]:
+    """(sid, lon, lat) for every section the tiles draw in `LAYERS` — streamed, a line at a time."""
+    import orjson
+    for name in LAYERS:
+        p = layers / f"{name}.geojsonl"
+        if not p.exists():
+            raise SystemExit(f"runs: {p} not found — the runs are bound to the tiles' own sections")
+        with open(p, "rb") as f:
+            for line in f:
+                d = orjson.loads(line)
+                pt = point_of(d["geometry"])
+                sid = d["properties"].get("section_id")
+                if pt is not None and sid is not None:
+                    yield int(sid), pt[0], pt[1]
+
+
+def km_between(a: Tuple[float, float], b: Tuple[float, float]) -> float:
+    lat = math.radians((a[1] + b[1]) / 2)
+    return 111.32 * math.hypot((a[0] - b[0]) * math.cos(lat), a[1] - b[1])
+
+
+# ---- the three relations -------------------------------------------------------------------------------------------
+
+def spawning(points: Iterable[Tuple[int, float, float]], polygons: Mapping[int, object],
+             keep: Optional[Dict[int, Tuple[float, float]]] = None) -> Dict[int, Set[int]]:
+    """{cuid: the sections whose point lies in its polygon}. `keep` (when given) collects every point read."""
+    from shapely.geometry import Point
+    from shapely.prepared import prep
+    from shapely.strtree import STRtree
+    ids = sorted(polygons)
+    geoms = [polygons[c] for c in ids]
+    pre = [prep(g) for g in geoms]
+    tree = STRtree(geoms)
+    out: Dict[int, Set[int]] = defaultdict(set)
+    for sid, lon, lat in points:
+        if keep is not None:
+            keep[sid] = (lon, lat)
+        pt = Point(lon, lat)
+        for i in tree.query(pt):
+            if pre[i].contains(pt):
+                out[ids[i]].add(sid)
+    return dict(out)
+
+
+def spawns(s: int, order: Mapping[int, int], lakes: Set[int], down: Mapping[int, Sequence[int]]) -> bool:
+    """Whether a section inside a CU takes its runs as spawning: a stream of order `MIN_ORDER`+, or a lake that drains."""
+    return bool(down.get(s)) if s in lakes else order.get(s, 0) >= MIN_ORDER
+
+
+def drop_spill(secs: Set[int], wsc_of: Mapping[int, str]) -> Set[int]:
+    """A CU's sections without the ones in a drainage it barely touches (its polygon crossing a divide)."""
+    from pipeline.common.utils import wsc as W
+    roots = Counter(W.root(wsc_of[s]) for s in secs if wsc_of.get(s))
+    tot = sum(roots.values()) or 1
+    keep = {r for r, n in roots.items() if (n / tot >= SPILL_SHARE and n >= SPILL_MIN) or n >= SPILL_KEEP}
+    return {s for s in secs if wsc_of.get(s) and W.root(wsc_of[s]) in keep}
+
+
+def passage(seeds: Set[int], down: Mapping[int, Sequence[int]], wsc_of: Mapping[int, str]) -> Set[int]:
+    """The sections a run crosses from `seeds` (its spawning sections) to the sea: the flow walked DOWN, every step's
+    FWA code an ancestor (or the code) of a seed's, the seeds themselves excluded."""
+    from pipeline.common.utils import wsc as W
+    allowed: Set[str] = set()
+    for s in seeds:
+        c = wsc_of.get(s)
+        if c:
+            allowed.add(c)
+            allowed.update(W.ancestors(c))
+    seen: Set[int] = set()
+    q = deque(sorted(seeds))
+    while q:
+        n = q.popleft()
+        for d in down.get(n, ()):
+            if d in seen or d in seeds or wsc_of.get(d, "") not in allowed:
+                continue
+            seen.add(d)
+            q.append(d)
+    return seen
+
+
+def km_to_sea(down: Mapping[int, Sequence[int]], length_m: Mapping[int, float],
+              line: Optional[Mapping[int, str]] = None) -> Dict[int, float]:
+    """River km from each section to its outlet: lengths summed down its OWN blue line where it goes on (`line`: the
+    section's FWA blue line), else down the shortest way out. The shortest way alone took a braid's dead-end side
+    channel for the sea (the lower Skeena read 0.8 km from it 48 km up). Iterative: a coastal mainstem is thousands of
+    sections deep."""
+    out: Dict[int, float] = {}
+    for start in length_m:
+        if start in out:
+            continue
+        stack, onpath = [start], set()
+        while stack:
+            n = stack[-1]
+            if n in out:
+                stack.pop()
+                continue
+            kids = [k for k in down.get(n, ()) if k in length_m]
+            pend = [k for k in kids if k not in out and k not in onpath]
+            if pend:
+                onpath.add(n)
+                stack.append(pend[0])
+                continue
+            same = [out[k] for k in kids if k in out and line is not None and line.get(k) and line.get(k) == line.get(n)]
+            done = same or [out[k] for k in kids if k in out]
+            out[n] = (length_m.get(n) or 0.0) + (min(done) if done else 0.0)
+            onpath.discard(n)
+            stack.pop()
+    return {k: v / 1000.0 for k, v in out.items()}
+
+
+def name_key(name: Optional[str]) -> str:
+    """A water's name for comparison: lower case, one space; a DFO stretch's suffix dropped ("BABINE RIVER - SECTION 4"
+    is the Babine River)."""
+    return " ".join((name or "").split(" - ")[0].lower().replace("'", "").split())
+
+
+def observed(dfo: Sequence[Tuple[int, TimedRun]], by_wsc: Mapping[str, Sequence[int]],
+             point: Mapping[int, Tuple[float, float]], length_m: Mapping[int, float],
+             name_of: Optional[Mapping[int, frozenset]] = None) -> Dict[int, Dict[tuple, int]]:
+    """{sid: {(slot, label): run index}} — each DFO record on its stream's sections, the nearest site winning.
+
+    A SITE BINDS THE SECTIONS OF ITS CODE THAT CARRY ITS NAME (`name_of`: the `name_key` of every name the atlas gives
+    each section — the Vedder's pieces carry "Chilliwack River" too, and NuSEDS's Chilliwack site is on them). NuSEDS gives a
+    slough or a side creek the FWA has no line for the code of the river it joins: Esker Slough's coho landed on 71
+    sections of the Skeena, Barrett Creek's on the Vedder. So where the code's sections are named and none is the
+    site's name, the site binds nothing; only an unnamed stream's sections take a site by its code alone.
+
+    ONE LEVEL DOWN, BY NAME: where no piece of the site's own code carries its name, the pieces one code level below
+    that do are its stream. NuSEDS files the Chilliwack River under 100-064535-057628, which the FWA gives the Vedder;
+    the FWA's Chilliwack is 100-064535-057628-998041."""
+    children: Dict[str, List[str]] = defaultdict(list)
+    for c in by_wsc:
+        if "-" in c:
+            children[c.rsplit("-", 1)[0]].append(c)
+    best: Dict[int, Dict[tuple, Tuple[tuple, int]]] = defaultdict(dict)
+    for ix, r in dfo:
+        secs = [s for s in by_wsc.get(r.wsc or "", ())]
+        if name_of is not None and any(name_of.get(s) for s in secs):
+            want = name_key(r.name)
+            secs = [s for s in secs if want in name_of.get(s, ())] or \
+                [s for c in sorted(children.get(r.wsc or "", ())) for s in by_wsc[c] if want in name_of.get(s, ())]
+        if not secs:
+            continue
+        site = (r.lon, r.lat) if r.lon is not None and r.lat is not None else None
+        long_water = sum(length_m.get(s, 0.0) for s in secs) / 1000.0 > LONG_WATER_KM
+        for s in secs:
+            d = km_between(point[s], site) if site and s in point else math.inf
+            if long_water and site and d > NEAR_SITE_KM:
+                continue
+            rank = (d, -(r.last_year or 0), -(r.years or 0), r.key)
+            k = (r.slot, r.label)
+            if k not in best[s] or rank < best[s][k][0]:
+                best[s][k] = (rank, ix)
+    return {s: {k: v[1] for k, v in m.items()} for s, m in best.items()}
+
+
+# ---- assembling the file -------------------------------------------------------------------------------------------
+
+def assemble(runs: Sequence[TimedRun], spawn: Mapping[int, Set[int]], passing: Mapping[int, Set[int]],
+             seen: Mapping[int, Mapping[tuple, int]], km: Mapping[int, float]):
+    """(profiles, {sid: (profile, km | None)}): each section's set of (run, relation), deduplicated. `spawn` and
+    `passing` are keyed by run index. A slot observed on a section drops that slot's PSF spawning runs there."""
+    per: Dict[int, Set[Tuple[int, int]]] = defaultdict(set)
+    for ix, secs in spawn.items():
+        for s in secs:
+            per[s].add((ix, SPAWNING))
+    for ix, secs in passing.items():
+        for s in secs:
+            per[s].add((ix, PASSAGE))
+    for s, m in seen.items():
+        slots = {k[0] for k in m}
+        per[s] = {(i, rel) for i, rel in per[s] if not (rel == SPAWNING and runs[i].slot in slots)}
+        per[s].update((i, OBSERVED) for i in m.values())
+    profiles: Dict[tuple, int] = {}
+    rows: Dict[int, Tuple[int, Optional[int]]] = {}
+    for s in sorted(per):
+        if not per[s]:
+            continue
+        key = tuple(sorted(per[s]))
+        pid = profiles.setdefault(key, len(profiles))
+        psf_here = any(runs[i].source == "psf" for i, _ in key)
+        rows[s] = (pid, int(round(km[s] / 10)) if psf_here and s in km else None)
+    return [list(k) for k, _ in sorted(profiles.items(), key=lambda kv: kv[1])], rows
+
+
+def header(runs: Sequence[TimedRun], profiles: Sequence[Sequence[Tuple[int, int]]], sources: Mapping[str, dict]) -> dict:
+    def one(r: TimedRun) -> dict:
+        d = {"s": r.source, "sp": r.species, "slot": SLOTS.index(r.slot), "n": r.name}
+        for k, v in (("l", r.label), ("pk", r.peak), ("w", list(r.window) if r.window else None), ("q", r.quality),
+                     ("y", [r.years, r.first_year, r.last_year] if r.years else None)):
+            if v is not None:
+                d[k] = v
+        return d
+    src = {k: {f: v[f] for f in ("credit", "title", "dataset", "updated", "licence") if f in v}
+           for k, v in sorted(sources.items())}
+    return {"slots": list(SLOTS), "sources": src, "runs": [one(r) for r in runs],
+            "profiles": [[i * 3 + rel for i, rel in p] for p in profiles]}
+
+
+def encode(runs: Sequence[TimedRun], profiles, rows: Mapping[int, Tuple[int, Optional[int]]], *, handles: str,
+           sources: Mapping[str, dict]) -> bytes:
+    v = lambda n: varint(n, "runs")                                    # noqa: E731
+    h = json.dumps(header(runs, profiles, sources), ensure_ascii=False, separators=(",", ":"),
+                   sort_keys=True).encode("utf-8")
+    out = bytearray(MAGIC + bytes([VERSION]) + bytes.fromhex(handles))
+    out += v(len(h)) + h
+    for r in runs:
+        out += bytes(r.curve)
+    out += v(len(rows))
+    prev = 0
+    for sid in sorted(rows):
+        pid, k = rows[sid]
+        out += v(sid - prev) + v(pid) + v(0 if k is None else k + 1)
+        prev = sid
+    return bytes(out)
+
+
+def decode(b: bytes) -> dict:
+    """The file back: {handles, header, curves: [[73]], rows: {sid: (profile, km | None)}} — whole, or refused."""
+    if b[:4] != MAGIC or len(b) < 13 or b[4] != VERSION:
+        raise ValueError("runs: not a runs/1 file")
+    handles = b[5:13].hex()
+    n, i = read_varint(b, 13)
+    head = json.loads(b[i:i + n].decode("utf-8"))
+    i += n
+    curves = []
+    for _ in head["runs"]:
+        curves.append(list(b[i:i + PENTADS]))
+        i += PENTADS
+    if i > len(b):
+        raise ValueError("runs: truncated curves")
+    count, i = read_varint(b, i)
+    rows, sid = {}, 0
+    for _ in range(count):
+        d, i = read_varint(b, i)
+        p, i = read_varint(b, i)
+        k, i = read_varint(b, i)
+        sid += d
+        if p >= len(head["profiles"]):
+            raise ValueError(f"runs: section {sid} names profile {p} of {len(head['profiles'])}")
+        rows[sid] = (p, None if k == 0 else k - 1)
+    if i != len(b):
+        raise ValueError(f"runs: {len(b) - i} trailing bytes")
+    return {"handles": handles, "header": head, "curves": curves, "rows": rows}
+
+
+def handles_of(b: bytes) -> str:
+    if b[:4] != MAGIC:
+        raise ValueError("runs: not a runs/1 file")
+    return b[5:13].hex()
+
+
+# ---- the step ------------------------------------------------------------------------------------------------------
+
+def load_polygons(path: Path) -> Dict[int, object]:
+    from shapely.geometry import shape
+    if not path.is_file():
+        raise SystemExit(f"runs: {path} not found — make it: python -m pipeline.runtiming.parse")
+    fc = json.loads(path.read_text())
+    return {int(f["id"]): shape(f["geometry"]).simplify(SIMPLIFY, preserve_topology=False).buffer(0)
+            for f in fc["features"]}
+
+
+def build(*, build_dir: Path, bundle: Path, tiles: Path, timing: Timing, polygons: Dict[int, object]) -> Tuple[bytes, dict]:
+    import sqlite3
+    from pipeline.common.section_handles import read as read_handles
+    from pipeline.common.utils.wsc import trim_wsc
+    b = sqlite3.connect(f"file:{bundle}?mode=ro", uri=True)
+    handles = dict(b.execute("SELECT k, v FROM meta"))["section_handles"]
+    meta = json.loads((tiles / "atlas.meta.json").read_text())
+    if meta.get("section_handles") != handles:
+        raise SystemExit(f"runs: the tiles at {tiles} carry section handles {meta.get('section_handles')}, not the "
+                         f"bundle's {handles}")
+    ids, by_id = read_handles(build_dir)
+    with open(build_dir / "graph.pkl", "rb") as fh:
+        graph = pickle.load(fh)
+    wsc_of: Dict[int, str] = {}
+    length_m: Dict[int, float] = {}
+    order: Dict[int, int] = {}
+    line: Dict[int, str] = {}
+    name_of: Dict[int, frozenset] = {}
+    lakes: Set[int] = set()
+    for nid, node in graph.nodes.items():
+        h = by_id.get(nid)
+        if h is None:
+            continue
+        wsc_of[h] = trim_wsc(node.wsc or "")
+        length_m[h] = node.length_m or 0.0
+        order[h] = node.stream_order or 0
+        line[h] = node.blk or ""
+        # every name the atlas gives the piece (the Vedder is also the Chilliwack), not only the one it displays
+        name_of[h] = frozenset(k for k in (name_key(n) for n in (node.display_name,
+                                                                  *(t.name for t in node.name_tuples))) if k)
+        if getattr(node.kind, "value", node.kind) == "lake":
+            lakes.add(h)
+    down: Dict[int, List[int]] = {}
+    for nid, idxs in graph.down_adj.items():
+        h = by_id.get(nid)
+        outs = sorted({by_id[graph.edges[i].to_node] for i in idxs if graph.edges[i].to_node in by_id})
+        if h is not None and outs:
+            down[h] = outs
+    del graph
+    point: Dict[int, Tuple[float, float]] = {}
+    psf = list(timing.psf)
+    cu = spawning(section_points(tiles / "layers"), polygons, keep=point)
+    runs: List[TimedRun] = psf + list(timing.dfo)
+    spawn: Dict[int, Set[int]] = {}
+    passing: Dict[int, Set[int]] = {}
+    for ix, r in enumerate(psf):
+        secs = {s for s in drop_spill(cu.get(r.cuid, set()), wsc_of) if spawns(s, order, lakes, down)}
+        if secs:
+            spawn[ix] = secs
+            passing[ix] = passage(secs, down, wsc_of)
+    by_wsc: Dict[str, List[int]] = defaultdict(list)
+    for s, c in wsc_of.items():
+        if c:
+            by_wsc[c].append(s)
+    dfo = [(len(psf) + j, r) for j, r in enumerate(timing.dfo)]
+    # a lake site binds the lake; a stream site the stream's own pieces (never a lake the stream's code also names)
+    by_wsc_stream = {c: [s for s in v if s not in lakes] for c, v in by_wsc.items()}
+    by_wsc_lake = {c: [s for s in v if s in lakes] for c, v in by_wsc.items()}
+    seen: Dict[int, Dict[tuple, int]] = {}
+    for kind, idx in (("lake", by_wsc_lake), ("stream", by_wsc_stream)):
+        part = [(ix, r) for ix, r in dfo if ((r.site_kind or "").startswith("Lake")) == (kind == "lake")]
+        for s, m in observed(part, idx, point, length_m, name_of).items():
+            seen.setdefault(s, {}).update(m)
+    km = km_to_sea(down, length_m, line)
+    profiles, rows = assemble(runs, spawn, passing, seen, km)
+    raw = encode(runs, profiles, rows, handles=handles, sources=timing.sources)
+    report = {"runs": len(runs), "psf_runs_bound": len(spawn), "profiles": len(profiles), "sections": len(rows),
+              "spawning_sections": len({s for v in spawn.values() for s in v}),
+              "passage_sections": len({s for v in passing.values() for s in v}),
+              "observed_sections": len(seen),
+              "dfo_records_bound": len({i for m in seen.values() for i in m.values()}), "bytes": len(raw)}
+    return raw, report
+
+
+def main(argv=None) -> int:
+    from pipeline.common.curated import CURATED, GENERATED
+    from pipeline.runtiming.timing import read_timing
+    ap = argparse.ArgumentParser(prog="pipeline.deliver runs", description=__doc__.split("\n\n")[0])
+    ap.add_argument("--build", type=Path, default=None)
+    ap.add_argument("--bundle", type=Path, required=True)
+    ap.add_argument("--tiles", type=Path, default=None)
+    ap.add_argument("--timing", type=Path, default=None)
+    ap.add_argument("--polygons", type=Path, default=None)
+    ap.add_argument("--out", type=Path, required=True)
+    a = ap.parse_args(argv)
+    raw, report = build(build_dir=a.build or GENERATED.require_build(), bundle=a.bundle,
+                        tiles=a.tiles or GENERATED.tiles, timing=read_timing(a.timing or CURATED.runtiming.timing),
+                        polygons=load_polygons(a.polygons or GENERATED.runtiming / "cu_polygons.geojson"))
+    decode(raw)                                                          # whole, or refused here
+    a.out.parent.mkdir(parents=True, exist_ok=True)
+    a.out.write_bytes(raw)
+    print(f"runs: {json.dumps(report, sort_keys=True)} -> {a.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
