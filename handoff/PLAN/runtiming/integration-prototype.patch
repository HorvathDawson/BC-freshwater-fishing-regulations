+    assert R.drop_spill(secs, wsc) == set(range(1, 201))
+    # a real second drainage (>= 1 % and >= 5 sections) stays
+    wsc.update({s: "500-3" for s in range(190, 201)})
+    assert R.drop_spill(secs, wsc) == secs
