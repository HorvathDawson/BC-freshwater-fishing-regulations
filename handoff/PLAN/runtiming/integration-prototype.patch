+def test_the_file_round_trips_and_says_what_it_is():
+    runs = [run("psf:7", species="Steelhead", name="Skeena Coastal Winters", label="winter", peak="Jan 7",
+                window=("Nov 2", "Apr 1"), quality="Medium", cuid=7, curve=[100] + [0] * 72),
+            run("dfo:1", "dfo", "Coho", name="Chilliwack River", window=("Sep 15", "Jan 15"), years=14,
+                first_year=1958, last_year=1991, wsc="100-1", curve=[0] * 72 + [50])]
+    profiles = [[(0, R.SPAWNING)], [(0, R.PASSAGE), (1, R.OBSERVED)]]
+    rows = {3: (0, 120), 300: (1, None)}
+    src = {"psf": {"credit": CREDIT["psf"], "updated": "2024-09-10", "runs": 1},
+           "dfo": {"credit": CREDIT["dfo"], "licence": "Open Government Licence – Canada", "records": 1}}
+    raw = R.encode(runs, profiles, rows, handles="d768d6e135e62b99", sources=src)
+    assert raw[:13] == b"BCRN" + bytes([1]) + bytes.fromhex("d768d6e135e62b99")
+    got = R.decode(raw)
+    assert got["handles"] == "d768d6e135e62b99" and got["rows"] == rows
+    assert got["curves"] == [list(r.curve) for r in runs]
+    h = got["header"]
+    assert h["slots"] == list(SLOTS) and h["profiles"] == [[0], [1, 5]]
+    assert h["runs"] == [{"s": "psf", "sp": "Steelhead", "slot": 6, "n": "Skeena Coastal Winters", "l": "winter",
+                          "pk": "Jan 7", "w": ["Nov 2", "Apr 1"], "q": "Medium"},
+                         {"s": "dfo", "sp": "Coho", "slot": 2, "n": "Chilliwack River", "w": ["Sep 15", "Jan 15"],
+                          "y": [14, 1958, 1991]}]
+    # only what a reader shows of each source travels (no counts)
+    assert h["sources"] == {"dfo": {"credit": CREDIT["dfo"], "licence": "Open Government Licence – Canada"},
+                            "psf": {"credit": CREDIT["psf"], "updated": "2024-09-10"}}
+    # the section tail, exactly: count 2; sid 3 profile 0 km 120 (+1); sid +297 profile 1 no km
+    assert raw.endswith(bytes([2, 3, 0, 121, 0xa9, 0x02, 1, 0]))
+    with pytest.raises(ValueError, match="trailing"):
+        R.decode(raw + b"\0")
+
