index 00000000..7e09c43b
--- /dev/null
+++ b/app/packages/core/src/runTiming.ts
@@ -0,0 +1,304 @@
+/**
+ * RUN TIMING (T162): the release file `runs` (format `runs/1`, `pipeline/deliver/runs.py`) — which salmon and steelhead
+ * runs are on each section, how each relates to it, and when each is in the water. The Fish runs colouring reads one
+ * number per section from it (`runLabel`, the colouring engine's `runs` channel); a tap reads the list (`runsHere`).
+ *
+ * Two sources, credited wherever a timing shows (owner 2026-10-24): the Pacific Salmon Foundation (Salmon Watersheds
+ * Program)'s average run timing per Conservation Unit — dated at RIVER ENTRY — and Fisheries and Oceans Canada's NuSEDS
+ * spawner surveys — dated IN THE STREAM surveyed. Three relations, never merged:
+ *   spawning  the section is inside the run's Conservation Unit (PSF)
+ *   passage   the run swims through the section on its way upstream (PSF)
+ *   observed  DFO surveyed this run in this stream; on that section it replaced the CU's spawning curve
+ *
+ * A REACH HAS RUNS, NOT A RUN: the Skeena carries a summer and a winter steelhead run six months apart, so the colour
+ * takes the strongest run of the species on the date and the sheet lists every one. Pink is two brood lines that never
+ * share a year; the map and the sheet pick the line of the year shown.
+ *
+ * Layout (little-endian, LEB128 varints): b"BCRN", u8 1, 8 bytes section_handles, header length + UTF-8 JSON
+ * {slots, sources, runs, profiles}, runs × 73 curve bytes (0..100), count, then per section (sid ascending) sid delta,
+ * profile, TENS of km to the sea + 1 (0: none). A section the file does not list has no run recorded — which is never "no fish".
+ */
+import { PUBLISHERS } from "./menu/words";
+import { utf8 } from "./statusIndex";
+
+/** The colour slots, in the file's order (`pipeline/runtiming/timing.py` SLOTS). */
+export const RUN_SLOTS = ["Chinook", "Chum", "Coho", "Pink (even)", "Pink (odd)", "Sockeye", "Steelhead"] as const;
+
+/** The species a reader picks, in the picker's order; steelhead first and the default (T162 Q144). */
+export const RUN_SPECIES = ["Steelhead", "Chinook", "Coho", "Sockeye", "Chum", "Pink"] as const;
+export type RunSpecies = typeof RUN_SPECIES[number];
+export const DEFAULT_RUN_SPECIES: RunSpecies = "Steelhead";
+
+export type RunRelation = "spawning" | "passage" | "observed";
+const RELATIONS: readonly RunRelation[] = ["spawning", "passage", "observed"];
+
+export interface TimedRun {
+  readonly source: "psf" | "dfo";
+  readonly species: string;
+  /** Index into `RUN_SLOTS`. */
+  readonly slot: number;
+  /** The Conservation Unit's name (psf) or the surveyed stream's (dfo). */
+  readonly name: string;
+  readonly label: string | null;
+  readonly peak: string | null;
+  readonly window: readonly [string, string] | null;
+  readonly quality: string | null;
+  /** dfo: how many surveyed years, the first and the last. */
+  readonly years: readonly [number, number, number] | null;
+  /** 73 pentads, 0..100. */
+  readonly curve: Uint8Array;
+}
+
+export interface RunEntry { readonly run: number; readonly relation: RunRelation }
+
+export interface RunSource { readonly credit: string; readonly title?: string; readonly updated?: string;
+                             readonly licence?: string; readonly dataset?: string }
+
+export interface RunTiming {
+  readonly handles: string;
+  readonly sources: Readonly<Partial<Record<"psf" | "dfo", RunSource>>>;
+  readonly runs: readonly TimedRun[];
+  /** How many sections carry a run: 0 means the Fish runs colouring has nothing to colour. */
+  readonly sections: number;
+  /** The section's runs, or none. */
+  entries(sid: number): readonly RunEntry[];
+  /** River km from the section to the sea, to the nearest 10, where a PSF run is on it; else null. */
+  kmOf(sid: number): number | null;
+  /** The profile a section is in (sections sharing one share every answer), or null. */
+  profileOf(sid: number): number | null;
+}
+
+export class RunTimingError extends Error {}
+
+interface Header {
+  slots: string[];
+  sources: Record<string, RunSource>;
+  runs: { s: "psf" | "dfo"; sp: string; slot: number; n: string; l?: string; pk?: string; w?: [string, string];
+          q?: string; y?: [number, number, number] }[];
+  profiles: number[][];
+}
+
+export function decodeRunTiming(b: Uint8Array, handles: string): RunTiming {
+  const fail = (why: string): never => { throw new RunTimingError(`run timing: ${why}`); };
+  if (b.length < 13 || b[0] !== 0x42 || b[1] !== 0x43 || b[2] !== 0x52 || b[3] !== 0x4e || b[4] !== 1)
+    fail("not a runs/1 file");
+  let digest = "";
+  for (let i = 5; i < 13; i++) digest += b[i]!.toString(16).padStart(2, "0");
+  if (digest !== handles) fail(`built for handles ${digest}, not ${handles}`);
+  let i = 13;
+  const varint = (): number => {
+    let n = 0, mul = 1;
+    for (;;) {
+      if (i >= b.length) fail("truncated");
+      const x = b[i++]!;
+      n += (x & 0x7f) * mul;
+      if (!(x & 0x80)) return n;
+      mul *= 128;
+    }
+  };
+  const hlen = varint();
+  if (i + hlen > b.length) fail("truncated header");
+  const h = JSON.parse(utf8(b.subarray(i, i + hlen))) as Header;
+  i += hlen;
+  if (h.slots.join("|") !== RUN_SLOTS.join("|")) fail(`slots ${h.slots.join(", ")}`);
+  const runs: TimedRun[] = h.runs.map((r) => {
+    if (i + 73 > b.length) fail("truncated curves");
+    const curve = b.slice(i, i + 73);
+    i += 73;
+    return { source: r.s, species: r.sp, slot: r.slot, name: r.n, label: r.l ?? null, peak: r.pk ?? null,
+             window: r.w ?? null, quality: r.q ?? null, years: r.y ?? null, curve };
+  });
+  const profiles: RunEntry[][] = h.profiles.map((p) => p.map((v) => {
+    const run = Math.floor(v / 3), rel = RELATIONS[v % 3]!;
+    if (run >= runs.length) fail(`profile names run ${run} of ${runs.length}`);
+    return { run, relation: rel };
+  }));
+  const n = varint();
+  const sids = new Int32Array(n), prof = new Int32Array(n), km = new Int32Array(n);
+  let sid = 0;
+  for (let k = 0; k < n; k++) {
+    sid += varint();
+    sids[k] = sid;
+    const p = varint();
+    if (p >= profiles.length) fail(`section ${sid} names profile ${p}`);
+    prof[k] = p;
+    km[k] = varint() - 1;
+  }
+  if (i !== b.length) fail(`${b.length - i} trailing bytes`);
+  const at = (s: number): number => {
+    let lo = 0, hi = n - 1;
+    while (lo <= hi) {
+      const mid = (lo + hi) >> 1, v = sids[mid]!;
+      if (v === s) return mid;
+      if (v < s) lo = mid + 1; else hi = mid - 1;
+    }
+    return -1;
+  };
+  return {
+    handles: digest, sources: h.sources, runs, sections: n,
+    entries: (s) => { const k = at(s); return k < 0 ? [] : profiles[prof[k]!]!; },
+    kmOf: (s) => { const k = at(s); return k < 0 || km[k]! < 0 ? null : km[k]! * 10; },
+    profileOf: (s) => { const k = at(s); return k < 0 ? null : prof[k]!; },
+  };
+}
+
+// ---- the date -------------------------------------------------------------------------------------------------------
+
+const MONTH_START = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
+
+/** The pentad (0..72) a CALENDAR date falls in, on the common year the curves are drawn on (Feb 29 is Feb 28). */
+export function pentadOf(d: Date): number {
+  const day = MONTH_START[d.getMonth()]! + Math.min(d.getDate(), d.getMonth() === 1 ? 28 : 31) - 1;
+  return Math.min(72, Math.floor(day / 5));
+}
+
+/** The slot a species colours by in a year: pink by its brood line (even years, odd years). */
+export function runSlot(species: RunSpecies, year: number): number {
+  const name = species === "Pink" ? (year % 2 === 0 ? "Pink (even)" : "Pink (odd)") : species;
+  return RUN_SLOTS.indexOf(name as typeof RUN_SLOTS[number]);
+}
+
+const LOCAL = (r: RunRelation) => r !== "passage";
+
+/**
+ * THE COLOUR LABEL (the style's `runs` mode, feature-state `run`) of a section for a species on a date:
+ *   1..100   a LOCAL run (spawning or surveyed here) at that share of its own peak — the strongest of the species
+ *   101..200 only a run PASSING THROUGH is in the water, at (label - 100)
+ *   0        runs of the species are recorded here, none is in the water on the date
+ *   undefined no run of the species is recorded here (no key: the mode's `missing`, said in the legend)
+ */
+export function runLabel(rt: RunTiming, sid: number, slot: number, pentad: number): number | undefined {
+  let any = false, local = 0, pass = 0;
+  for (const e of rt.entries(sid)) {
+    const r = rt.runs[e.run]!;
+    if (r.slot !== slot) continue;
+    any = true;
+    const v = r.curve[pentad]!;
+    if (LOCAL(e.relation)) local = Math.max(local, v); else pass = Math.max(pass, v);
+  }
+  if (!any) return undefined;
+  return local > 0 ? local : pass > 0 ? 100 + pass : 0;
+}
+
+/** `runLabel`, memoised per (profile, slot, pentad): every section of a profile has the same answer. */
+export function runLabeller(rt: RunTiming, slot: number, pentad: number): (sid: number) => number | undefined {
+  const memo = new Map<number, number | undefined>();
+  return (sid) => {
+    const p = rt.profileOf(sid);
+    if (p === null) return undefined;
+    if (memo.has(p)) return memo.get(p);
+    const v = runLabel(rt, sid, slot, pentad);
+    memo.set(p, v);
+    return v;
+  };
+}
+
+// ---- the words ------------------------------------------------------------------------------------------------------
+
+export const RUN_WORDS = {
+  layer: "Fish runs",
+  layerNote: "When salmon and steelhead are in the water",
+  title: "Fish runs here",
+  none: "No salmon or steelhead run is recorded here. That is not the same as no fish.",
+  relation: {
+    spawning: "Spawns in this watershed",
+    passage: "Passes through here",
+    observed: "Seen in this stream (DFO spawner surveys)",
+  } satisfies Record<RunRelation, string>,
+  inNow: "In the water now",
+  notNow: "Not in the water now",
+  otherYears: (even: boolean) => `Runs in ${even ? "even" : "odd"} years only`,
+  psfWhen: (w: readonly [string, string] | null, peak: string | null) =>
+    [w ? `Enters fresh water ${w[0]} – ${w[1]}` : null, peak ? `peak ${peak}` : null].filter(Boolean).join(", "),
+  dfoWhen: (w: readonly [string, string] | null, peak: string | null) =>
+    [w ? `In the stream ${w[0]} – ${w[1]}` : null, peak ? `spawning peaks ${peak}` : null].filter(Boolean).join(", "),
+  dfoYears: (y: readonly [number, number, number]) =>
+    `${y[0]} surveyed ${y[0] === 1 ? "year" : "years"}, ${y[1] === y[2] ? `${y[1]}` : `${y[1]}–${y[2]}`}`,
+  psfQuality: (q: string) => `Data quality: ${q}`,
+  /** The note under every PSF run: what the dates mean, and where the reader stands. */
+  entryNote: (km: number | null) => km !== null && km >= 10
+    ? `PSF dates are when fish enter fresh water. This water is about ${km} km from the sea, so they reach it later.`
+    : "PSF dates are when fish enter fresh water.",
+  credit: `Run timing: ${PUBLISHERS.psf}; ${PUBLISHERS.dfo} (NuSEDS).`,
+  /** The sheet's way on to the tapped water's own screen (its regulations). */
+  openWater: "Open this water",
+  /** The Layers sheet's species row, under Fish runs. */
+  species: "Species",
+  legend: {
+    local: "Local run (spawning or surveyed here), stronger at its peak",
+    passing: "Run passing through",
+    off: "Recorded here, not in the water on the date",
+    missing: (sp: RunSpecies) => `No ${sp.toLowerCase()} run recorded`,
+  },
+} as const;
+
+export interface RunLineVM {
+  readonly species: string;
+  /** "Steelhead · summer run" */
+  readonly heading: string;
+  /** The CU's or the stream's name. */
+  readonly name: string;
+  readonly relation: string;
+  readonly when: string;
+  /** "In the water now" / "Not in the water now" / "Runs in odd years only". */
+  readonly now: string;
+  readonly inNow: boolean;
+  /** The survey years (dfo) or the data quality (psf), or null. */
+  readonly detail: string | null;
+  readonly source: "psf" | "dfo";
+}
+
+export interface RunsHereVM {
+  readonly title: string;
+  readonly lines: readonly RunLineVM[];
+  /** The river-entry note (when any PSF run is listed), else null. */
+  readonly note: string | null;
+  readonly empty: string | null;
+  readonly credit: string;
+}
+
+const SPECIES_ORDER = (sp: string) => {
+  const i = (RUN_SPECIES as readonly string[]).indexOf(sp);
+  return i < 0 ? RUN_SPECIES.length : i;
+};
+
+/**
+ * THE SHEET: every run on a section, the species in the picker's order, local runs before passing ones, each with its
+ * relation, its dates in its source's own terms and whether it is in the water on the date. Pink's other brood line
+ * says which years it runs instead.
+ */
+export function runsHere(rt: RunTiming, sid: number, d: Date): RunsHereVM {
+  const p = pentadOf(d), year = d.getFullYear();
+  const entries = [...rt.entries(sid)].sort((a, b) => {
+    const ra = rt.runs[a.run]!, rb = rt.runs[b.run]!;
+    return SPECIES_ORDER(ra.species) - SPECIES_ORDER(rb.species)
+      || Number(!LOCAL(a.relation)) - Number(!LOCAL(b.relation))
+      || ra.name.localeCompare(rb.name) || a.run - b.run;
+  });
+  const lines = entries.map((e): RunLineVM => {
+    const r = rt.runs[e.run]!;
+    const slotName = RUN_SLOTS[r.slot]!;
+    const otherBrood = slotName.startsWith("Pink") && runSlot("Pink", year) !== r.slot;
+    const inNow = !otherBrood && r.curve[p]! > 0;
+    const label = r.label ? `${r.label} run` : null;
+    const brood = slotName.startsWith("Pink") ? (slotName.includes("even") ? "even years" : "odd years") : null;
+    return {
+      species: r.species,
+      heading: [r.species, label, brood].filter(Boolean).join(" · "),
+      name: r.name,
+      relation: RUN_WORDS.relation[e.relation],
+      when: r.source === "psf" ? RUN_WORDS.psfWhen(r.window, r.peak) : RUN_WORDS.dfoWhen(r.window, r.peak),
+      now: otherBrood ? RUN_WORDS.otherYears(slotName.includes("even")) : inNow ? RUN_WORDS.inNow : RUN_WORDS.notNow,
+      inNow,
+      detail: r.source === "dfo" ? (r.years ? RUN_WORDS.dfoYears(r.years) : null)
+        : r.quality && r.quality !== "Not Applicable" ? RUN_WORDS.psfQuality(r.quality) : null,
+      source: r.source,
+    };
+  });
+  return {
+    title: RUN_WORDS.title, lines,
+    note: lines.some((l) => l.source === "psf") ? RUN_WORDS.entryNote(rt.kmOf(sid)) : null,
+    empty: lines.length ? null : RUN_WORDS.none,
+    credit: RUN_WORDS.credit,
+  };
+}
