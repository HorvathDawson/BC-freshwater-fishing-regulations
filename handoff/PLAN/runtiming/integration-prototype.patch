+def test_a_site_binds_the_sections_of_its_code_that_carry_its_name():
+    esker = run("dfo:e", "dfo", "Coho", name="Esker Slough", wsc="400")
+    skeena = run("dfo:s", "dfo", "Coho", name="Skeena River - Lower", wsc="400")
+    creek = run("dfo:c", "dfo", "Coho", name="Unnamed Trib", wsc="400-9")
+    by_wsc = {"400": [1, 2], "400-9": [7]}
+    names = {1: frozenset({"skeena river"}), 2: frozenset({"skeena river", "lower skeena"}), 7: frozenset()}
+    got = R.observed([(4, esker), (5, skeena), (6, creek)], by_wsc, {}, {}, names)
+    # the slough names no Skeena section: it binds nothing; an unnamed stream takes its site by code alone
+    assert got == {1: {("Coho", None): 5}, 2: {("Coho", None): 5}, 7: {("Coho", None): 6}}
+    assert R.name_key("BABINE RIVER - SECTION 4") == R.name_key("Babine River") == "babine river"
+    # NuSEDS's Chilliwack is on the code the FWA gives the Vedder: one level down, the pieces carrying its name
