index 00000000..68c5726a
--- /dev/null
+++ b/app/packages/core/src/runTiming.test.ts
@@ -0,0 +1,143 @@
+/**
+ * (T162) THE RUN TIMINGS: the `runs/1` file read whole (the layout `pipeline/deliver/runs.py` writes, built here byte
+ * by byte), the date's pentad, the colour label's four meanings, and the sheet's every word (AGENTS 33: whole strings).
+ */
+import { describe, expect, it } from "vitest";
+import { RUN_SLOTS, RunTimingError, decodeRunTiming, pentadOf, runLabel, runLabeller, runSlot, runsHere,
+         type RunTiming } from "./runTiming";
+import { sourcesVM } from "./menu/sources";
+
+const HANDLES = "d768d6e135e62b99";
+
+function leb(n: number): number[] {
+  const out: number[] = [];
+  do { let b = n & 0x7f; n = Math.floor(n / 128); if (n) b |= 0x80; out.push(b); } while (n);
+  return out;
+}
+
+/** A runs/1 file, as the pipeline writes it. */
+function file(header: object, curves: number[][], rows: [number, number, number | null][], handles = HANDLES): Uint8Array {
+  const h = [...new TextEncoder().encode(JSON.stringify(header))];
+  const out = [0x42, 0x43, 0x52, 0x4e, 1, ...handles.match(/../g)!.map((x) => parseInt(x, 16)), ...leb(h.length), ...h];
+  for (const c of curves) out.push(...c);
+  out.push(...leb(rows.length));
+  let prev = 0;
+  for (const [sid, p, km] of rows) { out.push(...leb(sid - prev), ...leb(p), ...leb(km === null ? 0 : km + 1)); prev = sid; }
+  return new Uint8Array(out);
+}
+
+/** A curve 0 everywhere but `at` (pentad → value). */
+const curve = (at: Record<number, number>) => Array.from({ length: 73 }, (_, i) => at[i] ?? 0);
+const AUG_11 = pentadOf(new Date(2025, 7, 11));        // 222 // 5 = 44
+const JAN_7 = pentadOf(new Date(2025, 0, 7));          // 1
+
+const HEADER = {
+  slots: [...RUN_SLOTS],
+  sources: { psf: { credit: "Pacific Salmon Foundation (Salmon Watersheds Program)", updated: "2024-09-10" },
+             dfo: { credit: "Fisheries and Oceans Canada", licence: "Open Government Licence – Canada" } },
+  runs: [
+    { s: "psf", sp: "Steelhead", slot: 6, n: "Skeena Coastal Summers", l: "summer", pk: "Aug 11", w: ["Jul 2", "Oct 4"],
+      q: "Medium" },
+    { s: "psf", sp: "Steelhead", slot: 6, n: "Skeena Coastal Winters", l: "winter", pk: "Jan 7", w: ["Nov 20", "Mar 30"],
+      q: "Not Applicable" },
+    { s: "psf", sp: "Pink", slot: 3, n: "Lower Skeena River (even)", pk: "Aug 10", w: ["Jul 20", "Sep 1"] },
+    { s: "dfo", sp: "Coho", slot: 2, n: "Zymagotitz River", w: ["Sep 15", "Nov 30"], pk: "Nov 1", y: [12, 1998, 2024] },
+  ],
+  // profile 0: both steelheads spawning + even pink passing + the DFO coho; profile 1: the summer run passing only
+  profiles: [[0 * 3 + 0, 1 * 3 + 0, 2 * 3 + 1, 3 * 3 + 2], [0 * 3 + 1]],
+};
+const CURVES = [curve({ [AUG_11]: 100, [AUG_11 + 1]: 60 }), curve({ [JAN_7]: 100 }), curve({ [AUG_11]: 80 }),
+                curve({ 60: 50 })];
+const rt = (): RunTiming => decodeRunTiming(file(HEADER, CURVES, [[3, 0, 12], [300, 1, null]]), HANDLES);
+
+describe("decodeRunTiming", () => {
+  it("reads the runs, the profiles and each section's km (in tens) whole", () => {
+    const t = rt();
