+def test_passage_walks_down_but_never_into_another_drainage():
+    # 1 (a Skeena trib, 400-1) -> 2 (Skeena, 400) -> 3 (tidal, 400) -> 4 (the Nass's tidal water, 500) -> 5 (500)
+    down = {1: [2], 2: [3], 3: [4], 4: [5], 6: [2]}
+    wsc = {1: "400-1", 2: "400", 3: "400", 4: "500", 5: "500", 6: "400-2"}
+    assert R.passage({1}, down, wsc) == {2, 3}
+    # a seed's own sections are spawning, never passage
+    assert R.passage({1, 2}, down, wsc) == {3}
+
