+def test_a_dfo_site_binds_its_stream_and_on_a_long_water_only_near_the_site():
+    a = run("dfo:a", "dfo", "Coho", wsc="100-1", lon=-121.0, lat=49.0, years=10, last_year=2020)
+    b = run("dfo:b", "dfo", "Coho", wsc="100-1", lon=-121.0, lat=49.9, years=30, last_year=2024)
+    by_wsc = {"100-1": [1, 2, 3]}
+    point = {1: (-121.0, 49.01), 2: (-121.0, 49.89), 3: (-121.0, 49.45)}
+    short = {1: 1000.0, 2: 1000.0, 3: 1000.0}
+    # a short stream: every piece bound, each to its nearest site (3 is half way: the more recent survey wins)
+    assert R.observed([(5, a), (6, b)], by_wsc, point, short) == {1: {("Coho", None): 5}, 2: {("Coho", None): 6},
+                                                                  3: {("Coho", None): 6}}
+    # a long water (over LONG_WATER_KM): only the pieces within NEAR_SITE_KM of a site (3 is 50.1 km from both)
+    long_ = {1: 60_000.0, 2: 60_000.0, 3: 60_000.0}
+    assert R.observed([(5, a), (6, b)], by_wsc, point, long_) == {1: {("Coho", None): 5}, 2: {("Coho", None): 6}}
