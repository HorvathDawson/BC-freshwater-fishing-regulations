--- /dev/null
+++ b/app/packages/ui-native/src/RunsSheet.tsx
@@ -0,0 +1,45 @@
+/**
+ * (T162) THE RUNS HERE: a tap on the map while the water is coloured by Fish runs raises this — every salmon and
+ * steelhead run on the tapped section (`@app/core` `runsHere`): the species and its run, the CU or the surveyed stream
+ * it is named for, how it relates to this water (spawns here, passes through, seen in this stream by DFO), its dates in
+ * its source's own terms, and whether it is in the water on the date the map shows. The credit line is always drawn.
+ * "Open this water" goes on to the water's own screen, as a tap does under any other colouring. Draws the VM, decides
+ * nothing (AGENTS 25).
+ */
+import { RUN_WORDS, type RunsHereVM } from "@app/core";
+import { Text, View } from "react-native";
+import { Button } from "./Button";
+import { Sheet } from "./Sheet";
+import { TYPE } from "./type";
+import type { Palette } from "./theme";
+
+export function RunsSheet({ vm, palette, onClose, onOpenWater }: {
+  /** The runs on the tapped section; null: the sheet is down. */
+  vm: RunsHereVM | null; palette: Palette; onClose: () => void;
+  onOpenWater: () => void;
+}) {
+  return (
+    <Sheet open={vm !== null} onClose={onClose} title={vm?.title ?? RUN_WORDS.title} palette={palette} scroll>
+      <View testID="runs-here" style={{ paddingHorizontal: 20, paddingTop: 12, gap: 12 }}>
+        {vm?.empty && <Text style={{ ...TYPE.small, color: palette.sub }}>{vm.empty}</Text>}
+        {vm?.lines.map((l, i) => (
+          <View key={`${l.heading}:${l.name}:${i}`} testID="run-line"
+                style={{ borderTopWidth: i ? 1 : 0, borderTopColor: palette.line, paddingTop: i ? 10 : 0, gap: 2 }}>
+            <Text style={{ ...TYPE.bodyStrong, color: palette.ink }}>{l.heading}</Text>
+            <Text style={{ ...TYPE.small, color: palette.sub }}>{`${l.name} · ${l.relation}`}</Text>
+            {l.when ? <Text style={{ ...TYPE.small, color: palette.ink }}>{l.when}</Text> : null}
+            <Text style={{ ...TYPE.small, fontWeight: "700", color: l.inNow ? palette.accent : palette.sub }}>{l.now}</Text>
+            {l.detail && <Text style={{ ...TYPE.small, fontSize: 11.5, color: palette.faint }}>{l.detail}</Text>}
+          </View>
+        ))}
+        {vm?.note && <Text style={{ ...TYPE.small, fontSize: 11.5, color: palette.sub }}>{vm.note}</Text>}
+        <Text testID="runs-credit" style={{ ...TYPE.small, fontSize: 11.5, color: palette.faint }}>
+          {vm?.credit ?? RUN_WORDS.credit}
+        </Text>
+      </View>
+      <View style={{ flexDirection: "row", gap: 10, paddingHorizontal: 20, paddingTop: 16 }}>
+        <Button palette={palette} label={RUN_WORDS.openWater} onPress={onOpenWater} />
+      </View>
+    </Sheet>
+  );
+}
