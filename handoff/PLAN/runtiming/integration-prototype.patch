+ * HOW THE FISH RUNS REACH THE MAP (T162): the release's `runs` file (`WaterSource.runTiming`), the species the reader
+ * picked and the date the map shows, handed to the web map's colouring engine (`MapProps.runs`: the `runs` channel) —
+ * the same per-tile path as the day's status and the lake modes. Another species or another date relabels the loaded
+ * sections; a new release recolours them with no tile change.
+ *
+ * FETCHED ONLY WHEN WANTED: the file is ~800 kB, so it is read when the Fish runs colouring is chosen (or a tap asks
+ * for a section's runs), never on first paint. Whether it is OFFERED is read off the manifest (`BundleInfo.runs`), so
+ * the Layers sheet can enable it before anything is fetched. Only on a PROVEN PAIR, and only to a map that labels each
+ * tile (`coloursEachTile`): the native map has no per-tile event yet (N2), so there the colouring stays greyed.
+ */
+import { useMemo } from "react";
+import { pentadOf, runSlot, type RunSpecies, type RunTiming } from "@app/core";
+import type { WaterSource } from "@app/data";
+import { useAsync } from "./async";
+import { sourceKey } from "./conditionsColour";
+
+/** What the map is handed (`MapProps.runs`): the timings, the species' colour slot for the year, the date's pentad. */
+export interface RunFeedVM {
+  readonly timing: RunTiming;
+  readonly slot: number;
+  readonly pentad: number;
+}
+
+/** Whether the release ships run timings at all (the manifest's word; nothing is fetched to find out). */
+export function useRunsShipped(source: WaterSource, on: boolean): boolean {
+  const info = useAsync(() => source.info(), `runs-shipped:${sourceKey(source)}`, on);
+  return info.state === "ready" && info.value.runs === true;
+}
+
+/** The release's run timings, read once `wanted` (the colouring chosen, or a sheet open); null until then. */
+export function useRunTiming(source: WaterSource, wanted: boolean): RunTiming | null {
+  const t = useAsync(() => source.runTiming(), `runtiming:${sourceKey(source)}`, wanted);
+  return wanted && t.state === "ready" ? t.value : null;
+}
+
+/** The map's feed for a species on a day, or null (off, nothing loaded, or nothing to colour). */
+export function useRunColour(i: { timing: RunTiming | null; on: boolean; species: RunSpecies; day: Date }):
+    RunFeedVM | null {
+  const t = i.on ? i.timing : null;
+  const slot = runSlot(i.species, i.day.getFullYear()), pentad = pentadOf(i.day);
+  return useMemo(() => (t && t.sections > 0 ? { timing: t, slot, pentad } : null), [t, slot, pentad]);
+}
