#!/bin/sh
# (T1041) REBUILD THE LEDGER AND OWNER VIEWS after a merge (a pull):
# docs/views/LEDGER.md, DONE.md and OWNER.md, git-ignored, built from each ticket's row and `## Owner` block by
# app/tools/ledger.mjs. A branch from before T1041 has no tool and no views: nothing to build there.
root=$(git rev-parse --show-toplevel) || exit 0
[ -f "$root/app/tools/ledger.mjs" ] || exit 0
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
cd "$root" || exit 0
node app/tools/ledger.mjs --quiet || echo "post-merge: the ledger views were not rebuilt (see above): node app/tools/ledger.mjs" >&2
exit 0
