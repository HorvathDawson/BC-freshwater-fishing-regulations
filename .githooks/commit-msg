#!/bin/sh
# (T998) THE VERSIONED COMMIT-MSG HOOK: the message follows Conventional Commits, `<type>(<scope>)!: <subject>`
# (commitlint, pinned, with the repo's config: app/tools/commitlint.config.mjs; a ticket id in the header must have a
# ledger row). The same check runs in before_push.py and on every PR (docs-ci `commits`). Sub-second.
#
#   turn on, once per clone (worktrees share it):   git config core.hooksPath .githooks
#   emergency skip, said in the commit or PR:        git commit --no-verify
#
# Needs app/node_modules (pnpm -C app install --frozen-lockfile --prefer-offline): the check says so when it is missing.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd -P)
msg=$1
case $msg in /*) ;; *) msg=$(pwd -P)/$msg ;; esac
# git runs a hook with GIT_DIR and friends set; node and its git calls find the repo from the cwd instead (as pre-push)
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars) GIT_QUARANTINE_PATH
cd "$root"
exec node app/tools/check-commits.mjs --edit "$msg"
