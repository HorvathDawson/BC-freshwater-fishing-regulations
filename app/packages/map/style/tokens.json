{
  "$comment": "Design tokens. Layers reference these BY NAME and may never hard-code a value — that is what makes themes and per-user colour profiles possible without regenerating the style.",
  "tokens": {
    "color.water.regulated":     { "type": "color",  "themeable": true },
    "color.water.other":         { "type": "color",  "themeable": true },
    "color.highlight":           { "type": "color",  "themeable": true },
    "color.parcel.line":         { "type": "color",  "themeable": true },

    "color.status.open":         { "type": "color",  "themeable": true },
    "color.status.restricted":   { "type": "color",  "themeable": true },
    "color.status.closed":       { "type": "color",  "themeable": true },
    "color.status.unknown":      { "type": "color",  "themeable": true },
    "color.status.default_only": { "type": "color",  "themeable": true },

    "color.flow.low":            { "type": "color",  "themeable": true },
    "color.flow.normal":         { "type": "color",  "themeable": true },
    "color.flow.high":           { "type": "color",  "themeable": true },

    "width.stream.base":         { "type": "number", "themeable": false },
    "width.stream.highlight":    { "type": "number", "themeable": false },
    "opacity.overlay":           { "type": "number", "themeable": true }
  },

  "$enums": {
    "$comment": "Vocabularies a categorical colour mode can be declared over. A mode bound to an enum MUST colour every member — that is how `unknown` and `default_only` cannot be silently forgotten (doc 10 ⑨ / ㉜).",
    "reg_status": ["open", "restricted", "closed", "unknown", "default_only"]
  }
}
