      "surveyed": {
        "label": "Depth",
        "scale": "categorical",
        "property": "survey",
        "enum": "survey_state",
        "$comment": "Depth is about which lakes have been SURVEYED, not only which have digitised contours. 2,741 bathymetric sheets exist and only a fraction were ever traced into vector contours — colouring by contours alone shows a near-empty map and tells a reader the province was never surveyed, which is the opposite of true.",
        "categories": {
          "digitised": {
            "token": "color.survey.digitised"
          },
          "sheet": {
            "token": "color.survey.sheet"
          }
        },
        "missing": {
