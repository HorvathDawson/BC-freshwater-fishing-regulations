{
  "$comment": "GENERATED. The runtime reads this to build the layer/view UI and apply themes.",
  "groups": [
    {
      "id": "water",
      "label": "Water",
      "toggleable": false,
      "defaultVisible": true
    }
  ],
  "views": [
    {
      "id": "regulations",
      "label": "Regulations",
      "default": true,
      "modes": {
        "streams": "closure"
      }
    },
    {
      "id": "conditions",
      "label": "Conditions",
      "modes": {
        "streams": "discharge"
      }
    },
    {
      "id": "plain",
      "label": "Plain map",
      "modes": {
        "streams": "plain"
      }
    }
  ],
  "providers": {
    "regs": {
      "kind": "bundle",
      "key": "section_id",
      "freshness": "bundle",
      "$comment": "computed from rules + the selected date. Present for the 2.4% with an assessed rule; everything else is default_only."
    },
    "gauges": {
      "kind": "feed",
      "key": "item_id",
      "fanout": "item_to_sections",
      "freshness": "live",
      "staleAfterMs": 5400000,
      "$comment": "450 stations, 30-min refresh. Binds to item_id (durable), so it must fan out to that item's sections to colour a line."
    },
    "stocking": {
      "kind": "feed",
      "key": "item_id",
      "fanout": "item_to_sections",
      "freshness": "live",
      "staleAfterMs": 1209600000,
      "$comment": "per-waterbody release records, refreshed weekly. Two weeks is the stale threshold: one missed run is normal, two means the job is broken. Bound to item_id — stocking is INTO a lake, not onto a reach."
    },
    "in_season": {
      "kind": "feed",
      "key": "item_id",
      "fanout": "item_to_sections",
      "freshness": "live",
      "staleAfterMs": 43200000,
      "$comment": "mid-cycle closures and openings the printed synopsis cannot carry, scraped every 6 h. Twelve hours is the stale threshold — two missed runs. This is the ONLY channel that can correct a wrong answer between builds, so a client that cannot reach it must say 'could not check for a closure', never imply none."
    }
  },
  "layerGroup": {
    "streams": "water"
  },
  "highlightable": [
    {
      "id": "streams",
      "featureIdProperty": "section_id"
    }
  ],
  "colorModes": {
    "streams": {
      "plain": {
        "label": "Plain",
        "scale": "static",
        "color": {
          "token": "color.water.mapped"
        }
      },
      "closure": {
        "label": "Open / closed",
        "scale": "categorical",
        "property": "status",
        "enum": "reg_status",
        "categories": {
          "open": {
            "token": "color.status.open"
          },
          "restricted": {
            "token": "color.status.restricted"
          },
          "closed": {
            "token": "color.status.closed"
          },
          "unknown": {
            "token": "color.status.unknown"
          },
          "default_only": {
            "token": "color.status.default_only"
          }
        },
        "data": {
          "provider": "regs",
          "field": "status",
          "params": [
            "date"
          ]
        },
        "missing": {
          "token": "color.status.default_only"
        }
      },
      "discharge": {
        "label": "Water level",
        "scale": "continuous",
        "property": "discharge_pct",
        "stops": [
          [
            0,
            {
              "token": "color.flow.low"
            }
          ],
          [
            50,
            {
              "token": "color.flow.normal"
            }
          ],
          [
            100,
            {
              "token": "color.flow.high"
            }
          ]
        ],
        "missing": {
          "token": "color.water.mapped"
        },
        "data": {
          "provider": "gauges",
          "field": "discharge_pct"
        },
        "$comment": "`missing` is the NEUTRAL plain-water colour, not status.unknown. About 19,250 of 19,700 waters have no gauge, so this paints most of the map: using the regulatory-unknown violet here would mean 'we could not parse the rule' and 'there is no gauge' were the same colour."
      }
    }
  },
  "widths": {
    "streams": "width.stream.base"
  },
  "themes": {
    "dark": {
      "color.water.mapped": "#8a8f93",
      "color.water.unmapped": "#333d47",
      "color.highlight": "#ff77b8",
      "color.parcel.line": "#c9a86a",
      "color.status.open": "#48b07a",
      "color.status.restricted": "#e8a733",
      "color.status.unknown": "#a78bd0",
      "color.status.default_only": "#6e6e6e",
      "color.flow.low": "#43769f",
      "color.flow.normal": "#6fb3e5",
      "color.flow.high": "#a9d8f5",
      "width.stream.base": 1.4,
      "width.stream.highlight": 3.2,
      "opacity.overlay": 0.45,
      "color.status.closed": "#e05a4b"
    },
    "light": {
      "color.water.mapped": "#4a5c6e",
      "color.water.unmapped": "#d2dae2",
      "color.highlight": "#c2187a",
      "color.parcel.line": "#8a6d3b",
      "color.status.open": "#2e8b57",
      "color.status.restricted": "#8f5c00",
      "color.status.closed": "#c0392b",
      "color.status.unknown": "#7d5ba6",
      "color.status.default_only": "#8a8a8a",
      "color.flow.low": "#7fb3dd",
      "color.flow.normal": "#2f6f9f",
      "color.flow.high": "#0d3350",
      "width.stream.base": 1.4,
      "width.stream.highlight": 3.2,
      "opacity.overlay": 0.55
    }
  },
  "tokens": {
    "color.water.mapped": {
      "type": "color",
      "themeable": true
    },
    "color.water.unmapped": {
      "type": "color",
      "themeable": true
    },
    "color.highlight": {
      "type": "color",
      "themeable": true
    },
    "color.parcel.line": {
      "type": "color",
      "themeable": true
    },
    "color.status.open": {
      "type": "color",
      "themeable": true
    },
    "color.status.restricted": {
      "type": "color",
      "themeable": true
    },
    "color.status.closed": {
      "type": "color",
      "themeable": true
    },
    "color.status.unknown": {
      "type": "color",
      "themeable": true
    },
    "color.status.default_only": {
      "type": "color",
      "themeable": true
    },
    "color.flow.low": {
      "type": "color",
      "themeable": true
    },
    "color.flow.normal": {
      "type": "color",
      "themeable": true
    },
    "color.flow.high": {
      "type": "color",
      "themeable": true
    },
    "width.stream.base": {
      "type": "number",
      "themeable": false
    },
    "width.stream.highlight": {
      "type": "number",
      "themeable": false
    },
    "opacity.overlay": {
      "type": "number",
      "themeable": true
    }
  },
  "enums": {
    "$comment": "Vocabularies a categorical colour mode can be declared over. A mode bound to an enum MUST colour every member — that is how `unknown` and `default_only` cannot be silently forgotten (doc 10 ⑨ / ㉜).",
    "reg_status": [
      "open",
      "restricted",
      "closed",
      "unknown",
      "default_only"
    ]
  }
}
