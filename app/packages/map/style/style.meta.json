  "providers": {
    "regs": {
      "kind": "bundle",
      "key": "section_id",
      "freshness": "bundle",
      "$comment": "Status per section for a date AND a species group. Two parallel stacks: the provincial synopsis governs trout, char and coarse fish; DFO governs salmon. There is no blended answer, so the view carries the group."
    },
    "gauges": {
      "kind": "feed",
      "key": "section_id",
      "fanout": "section_to_station",
      "freshness": "live",
      "staleAfterMs": 5400000,
      "$comment": "450 stations, 30-min refresh. Keyed by SECTION, bridged to a station by the build's `section_gauge` precompute — and only where the magnitude ratio says that station can speak for the reach. Below the floor the section has no link at all and reports no gauge rather than borrowing a big river's number. It was declared `item_id`/`item_to_sections`, which is how stocking works, not this."
    },
    "stocking": {
      "kind": "feed",
      "key": "item_id",
      "fanout": "item_to_sections",
      "freshness": "live",
      "staleAfterMs": 1209600000,
      "$comment": "per-waterbody release records, refreshed weekly. Two weeks is the stale threshold: one missed run is normal, two means the job is broken. Bound to item_id — stocking is INTO a lake, not onto a reach."
    },
    "in_season": {
      "kind": "feed",
      "key": "item_id",
      "fanout": "item_to_sections",
      "freshness": "live",
      "staleAfterMs": 43200000,
      "$comment": "mid-cycle closures and openings the printed synopsis cannot carry, scraped every 6 h. Twelve hours is the stale threshold — two missed runs. This is the ONLY channel that can correct a wrong answer between builds, so a client that cannot reach it must say 'could not check for a closure', never imply none."
    },
    "lakes": {
      "kind": "bundle",
      "key": "section_id",
      "fanout": "section_to_item",
      "freshness": "bundle",
      "$comment": "Per-lake facts from the bundle: whether the lake was surveyed, and when it was last stocked. Keyed by section because that is what the tile carries; the fanout resolves it to the item the fact belongs to."
    }
  },
