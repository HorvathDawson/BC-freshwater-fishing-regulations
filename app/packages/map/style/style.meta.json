        "color": {
          "token": "color.water.mapped"
        }
      },
      "closure": {
        "label": "Open / closed",
        "scale": "categorical",
        "property": "status",
        "enum": "reg_status",
        "categories": {
          "open": {
            "token": "color.status.open"
          },
          "restricted": {
            "token": "color.status.restricted"
          },
          "closed": {
            "token": "color.status.closed"
