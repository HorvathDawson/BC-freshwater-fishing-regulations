{
  "$comment": "T548: ONE case file for the two readers of 'when is an in-season row in force' — TS `@app/core` `inSeasonSpan` (+ `joinInSeason` for `inForce`) and Python `pipeline.regs.inseason.matches.span`. Both tests read it (core inseason.test.ts, pipeline/tests/test_inseason_publish.py) and must give `expect` [from, to] for each case; `inForce` names days and whether the row is in effect on each. Rows marked `is-…` are real rows of the 2026-11-08 capture (data/generated/inseason/feed/index.json), cut to the fields the rule reads. `effective` is the curated override (notice_waters.json `effective`, the links' from/to).",
  "cases": [
    {"name": "the feed's printed dates",
     "row": {"id": "is-689cae172c40", "from": "2025-07-04", "to": "2025-08-31", "parsed": {"kinds": ["closure"], "window": null}},
     "expect": ["2025-07-04", "2025-08-31"], "inForce": {"2025-08-01": true, "2025-09-01": false}},
    {"name": "a curated `to` wins over an inferred end",
     "row": {"id": "x-1", "from": "2026-07-30", "to": null, "parsed": {"kinds": ["closure"], "window": {"from_month": 7, "from_day": 30, "to_month": 9, "to_day": 15}}},
     "effective": {"to": "2026-10-01"},
     "expect": ["2026-07-30", "2026-10-01"], "inForce": {"2026-09-30": true, "2026-10-02": false}},
    {"name": "a curated `to` wins over the feed's",
     "row": {"id": "x-2", "from": "2026-07-04", "to": "2026-08-31"},
     "effective": {"to": "2026-09-01"},
     "expect": ["2026-07-04", "2026-09-01"], "inForce": {}},
    {"name": "Fraser R2 steelhead: a yearly window (Aug 15–Dec 31) set on Sept 16 — no end inferred, in force in year two",
     "row": {"id": "is-8cd37f6e5bf9", "from": "2025-09-16", "to": null, "parsed": {"kinds": ["closure"], "window": {"from_month": 8, "from_day": 15, "to_month": 12, "to_day": 31}}},
     "expect": ["2025-09-16", null], "inForce": {"2025-09-15": false, "2026-01-01": true, "2026-11-09": true}},
    {"name": "Fraser R5 steelhead: January 1 to December 31 set on Sept 16 — in force after its first Dec 31",
     "row": {"id": "is-498820589328", "from": "2025-09-16", "to": null, "parsed": {"kinds": ["closure"], "window": {"from_month": 1, "from_day": 1, "to_month": 12, "to_day": 31}}},
     "expect": ["2025-09-16", null], "inForce": {"2026-01-01": true, "2026-11-09": true}},
    {"name": "Heber Creek: Nov 1 to Aug 31 set on Aug 27 (half the text is year-round) — never vanishes",
     "row": {"id": "is-74fcb31b2d0b", "from": "2026-08-27", "to": null, "parsed": {"kinds": ["closure", "gear"], "window": {"from_month": 11, "from_day": 1, "to_month": 8, "to_day": 31}}},
     "expect": ["2026-08-27", null], "inForce": {"2027-09-01": true}},
    {"name": "Okanagan River: a one-off summer closure opening on its effective day ends with its window",
     "row": {"id": "is-2fa458fef3c3", "from": "2026-07-30", "to": null, "parsed": {"kinds": ["closure"], "window": {"from_month": 7, "from_day": 30, "to_month": 9, "to_day": 15}}},
     "expect": ["2026-07-30", "2026-09-15"], "inForce": {"2026-07-29": false, "2026-09-15": true, "2026-09-16": false, "2026-11-09": false}},
    {"name": "Granby River's Tributaries ('July 30-Sept 15'): one-off, hidden after its window",
     "row": {"id": "is-79fcd6f4a6bc", "from": "2026-07-30", "to": null, "parsed": {"kinds": ["closure"], "window": {"from_month": 7, "from_day": 30, "to_month": 9, "to_day": 15}}},
     "expect": ["2026-07-30", "2026-09-15"], "inForce": {"2026-11-09": false}},
    {"name": "a one-off window over the new year rolls on",
     "row": {"id": "x-3", "from": "2026-11-01", "to": null, "parsed": {"kinds": ["closure"], "window": {"from_month": 11, "from_day": 1, "to_month": 3, "to_day": 31}}},
     "expect": ["2026-11-01", "2027-03-31"], "inForce": {"2027-03-31": true, "2027-04-01": false}},
    {"name": "a rescind's quoted window is not its end",
     "row": {"id": "is-7826b2108311", "from": "2025-05-16", "to": null, "parsed": {"kinds": ["rescind"], "window": {"from_month": 9, "from_day": 1, "to_month": 11, "to_day": 15}}},
     "expect": ["2025-05-16", null], "inForce": {"2026-11-09": true}},
    {"name": "a window with no start day infers nothing",
     "row": {"id": "x-4", "from": "2026-07-01", "to": null, "parsed": {"kinds": ["closure"], "window": {"to_month": 9, "to_day": 15}}},
     "expect": ["2026-07-01", null], "inForce": {}},
    {"name": "a row with only a `from`: in force from it until the page drops it",
     "row": {"id": "is-c77bf6cd7da6", "from": "2025-11-18", "to": null, "parsed": {"kinds": ["closure"], "window": null}},
     "expect": ["2025-11-18", null], "inForce": {"2025-11-17": false, "2025-11-18": true, "2030-01-01": true}}
  ]
}
