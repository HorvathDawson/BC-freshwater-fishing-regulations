    "worked": {
     "label": "How it adds up",
     "lines": [
      {
       "a": "that’s your trout and char for the day, everywhere.",
       "at": "here",
       "q": "If you keep 5 rainbow trout here:"
      },
      {
       "a": "they don’t use up your 2 from streams here, but on other streams they count as them: none from other streams today — up to 3 more of any kind, from here or from lakes.",
       "at": "here",
       "q": "If you keep 2 rainbow trout here:"
      },
      {
       "a": "Keep 4 more here. Fish from lakes count toward the 5 a day, not toward the 2 from streams.",
       "at": "elsewhere",
       "q": "Kept 1 at a lake?"
      },
      {
       "a": "It counts here too: at most 1 over 50 cm (20 in) a day in all.",
       "at": "elsewhere",
       "q": "Kept cutthroat trout over 50 cm (20 in) elsewhere today?"
      }
     ],
     "says": "Your own limit, counted across every Region 4 stream you fish today."
    },
    "year": {
     "label": "Through the year",
     "says": "You can keep them until Oct 31. Then release only from Nov 1."
