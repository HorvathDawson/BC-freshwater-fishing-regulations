+++ b/android/src/main/java/org/maplibre/reactnative/components/sources/tilesources/vectorsource/TileIds.kt
@@ -0,0 +1,222 @@
+package org.maplibre.reactnative.components.sources.tilesources.vectorsource
+
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.RandomAccessFile
+import java.util.zip.GZIPInputStream
+
+/**
+ * (canifishthis T74 patch) A LOCAL PMTiles archive's tiles, read for their MVT feature ids only.
+ *
+ * The app colours each section in the tile it arrives in (its colouring engine labels the tile's sections by
+ * feature-state). MapLibre Native reports WHICH tile it is requesting (`OnTileActionListener`) but never what is in it,
+ * so the ids are read here from the same archive the source draws (`pmtiles://file:///…`): header, directories
+ * (internal compression), the tile (tile compression), then layer name + feature id out of the protobuf — geometry and
+ * tags are skipped unread. PMTiles spec v3; MVT 2.1.
+ */
+internal class PmTilesIds(path: String) {
+    private val file = RandomAccessFile(File(path), "r")
+    private val rootOffset: Long
+    private val rootLength: Int
+    private val leafOffset: Long
+    private val tileDataOffset: Long
+    private val internalCompression: Int
+    private val tileCompression: Int
+    private val minZoom: Int
+    private val maxZoom: Int
+    private val dirs = object : LinkedHashMap<Long, Dir>(64, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<Long, Dir>?) = size > 64
+    }
+
+    init {
+        val h = read(0, 127)
+        if (le16(h, 0) != 0x4D50) throw IllegalArgumentException("not a PMTiles archive: $path")
+        rootOffset = le64(h, 8)
+        rootLength = le64(h, 16).toInt()
+        leafOffset = le64(h, 40)
+        tileDataOffset = le64(h, 56)
+        internalCompression = h[97].toInt() and 0xff
+        tileCompression = h[98].toInt() and 0xff
+        minZoom = h[100].toInt() and 0xff
+        maxZoom = h[101].toInt() and 0xff
+    }
+
+    fun close() = file.close()
+
+    /** The ids of each layer named in `layers` in tile z/x/y, or null where the archive has no such tile. */
+    fun ids(z: Int, x: Int, y: Int, layers: Set<String>): Map<String, IntArray>? {
+        if (z < minZoom || z > maxZoom) return null
+        val bytes = tile(z, x, y) ?: return null
+        return mvtIds(decompress(bytes, tileCompression), layers)
+    }
+
+    @Synchronized
+    private fun read(offset: Long, length: Int): ByteArray {
+        val b = ByteArray(length)
+        file.seek(offset)
+        file.readFully(b)
+        return b
+    }
+
+    private class Dir(val tileId: LongArray, val offset: LongArray, val length: IntArray, val runLength: LongArray)
+
+    private fun dir(offset: Long, length: Int): Dir {
+        synchronized(dirs) { dirs[offset]?.let { return it } }
+        val d = deserialize(decompress(read(offset, length), internalCompression))
+        synchronized(dirs) { dirs[offset] = d }
+        return d
+    }
+
+    private fun tile(z: Int, x: Int, y: Int): ByteArray? {
+        val id = zxyToTileId(z, x, y)
+        var dOff = rootOffset
+        var dLen = rootLength
+        for (depth in 0..3) {
+            val d = dir(dOff, dLen)
+            val i = find(d, id)
+            if (i < 0) return null
+            if (d.runLength[i] > 0) return read(tileDataOffset + d.offset[i], d.length[i])
+            dOff = leafOffset + d.offset[i]
+            dLen = d.length[i]
+        }
+        return null
+    }
+
+    private fun find(d: Dir, id: Long): Int {
+        var lo = 0
+        var hi = d.tileId.size - 1
+        while (lo <= hi) {
+            val mid = (lo + hi) ushr 1
+            val c = id - d.tileId[mid]
+            if (c > 0) lo = mid + 1 else if (c < 0) hi = mid - 1 else return mid
+        }
+        return if (hi >= 0 && (d.runLength[hi] == 0L || id - d.tileId[hi] < d.runLength[hi])) hi else -1
+    }
+
+    private class Cursor(val b: ByteArray, var pos: Int = 0, val end: Int = b.size) {
+        fun varint(): Long {
+            var r = 0L
+            var shift = 0
+            while (true) {
+                if (pos >= end) throw IllegalStateException("truncated varint")
+                val v = b[pos++].toInt() and 0xff
+                r = r or ((v and 0x7f).toLong() shl shift)
+                if (v < 0x80) return r
+                shift += 7
+                if (shift > 63) throw IllegalStateException("varint too long")
+            }
+        }
+
+        fun skip(wire: Int) {
+            when (wire) {
+                0 -> varint()
+                1 -> pos += 8
+                2 -> { val n = varint().toInt(); pos += n }   // the length first: `pos += varint()` reads pos before the varint moves it
+                5 -> pos += 4
+                else -> throw IllegalStateException("wire type $wire")
+            }
+        }
+    }
+
+    private fun deserialize(b: ByteArray): Dir {
+        val c = Cursor(b)
+        val n = c.varint().toInt()
+        val tileId = LongArray(n)
+        val offset = LongArray(n)
+        val length = IntArray(n)
+        val runLength = LongArray(n)
+        var last = 0L
+        for (i in 0 until n) { last += c.varint(); tileId[i] = last }
+        for (i in 0 until n) runLength[i] = c.varint()
+        for (i in 0 until n) length[i] = c.varint().toInt()
+        for (i in 0 until n) {
+            val v = c.varint()
+            offset[i] = if (v == 0L && i > 0) offset[i - 1] + length[i - 1] else v - 1
+        }
+        return Dir(tileId, offset, length, runLength)
+    }
+
+    companion object {
+        private fun le16(b: ByteArray, o: Int) = (b[o].toInt() and 0xff) or ((b[o + 1].toInt() and 0xff) shl 8)
+
+        private fun le64(b: ByteArray, o: Int): Long {
+            var r = 0L
+            for (i in 7 downTo 0) r = (r shl 8) or (b[o + i].toLong() and 0xff)
+            return r
+        }
+
+        private fun decompress(b: ByteArray, c: Int): ByteArray = when (c) {
+            0, 1 -> b
+            2 -> GZIPInputStream(ByteArrayInputStream(b)).use { s ->
+                val out = ByteArrayOutputStream(b.size * 4)
+                s.copyTo(out)
+                out.toByteArray()
+            }
+            else -> throw IllegalStateException("compression $c not supported")
+        }
+
+        /** The Hilbert tile id (PMTiles v3), as the JS reference `zxyToTileId` computes it. */
+        fun zxyToTileId(z: Int, x: Int, y: Int): Long {
+            var acc = ((1L shl z) * (1L shl z) - 1) / 3
+            var n = z - 1
+            var tx = x.toLong()
+            var ty = y.toLong()
+            var a = if (z == 0) 0L else 1L shl (z - 1)
+            while (a > 0) {
+                val rx = tx and a
+                val ry = ty and a
+                acc += ((3 * rx) xor ry) * (1L shl n)
+                if (ry == 0L) {
+                    if (rx != 0L) { val t = a - 1 - ty; ty = a - 1 - tx; tx = t } else { val t = ty; ty = tx; tx = t }
+                }
+                n--
+                a = a shr 1
+            }
+            return acc
+        }
+
+        /** Layer name -> feature ids, for the layers asked; a feature without an id is skipped. */
+        fun mvtIds(b: ByteArray, layers: Set<String>): Map<String, IntArray> {
+            val out = HashMap<String, IntArray>()
+            val t = Cursor(b)
+            while (t.pos < t.end) {
+                val key = t.varint().toInt()
+                if (key ushr 3 != 3 || key and 7 != 2) { t.skip(key and 7); continue }
+                val len = t.varint().toInt()
+                val l = Cursor(b, t.pos, t.pos + len)
+                t.pos += len
+                var name: String? = null
+                var ids = IntArray(64)
+                var n = 0
+                while (l.pos < l.end) {
+                    val k = l.varint().toInt()
+                    when {
+                        k ushr 3 == 1 && k and 7 == 2 -> {
+                            val sl = l.varint().toInt()
+                            name = String(b, l.pos, sl, Charsets.UTF_8)
+                            l.pos += sl
+                        }
+                        k ushr 3 == 2 && k and 7 == 2 -> {
+                            val fl = l.varint().toInt()
+                            val f = Cursor(b, l.pos, l.pos + fl)
+                            l.pos += fl
+                            while (f.pos < f.end) {
+                                val fk = f.varint().toInt()
+                                if (fk ushr 3 == 1 && fk and 7 == 0) {
+                                    if (n == ids.size) ids = ids.copyOf(n * 2)
+                                    ids[n++] = f.varint().toInt()
+                                    break
+                                }
+                                f.skip(fk and 7)
+                            }
+                        }
+                        else -> l.skip(k and 7)
+                    }
+                }
+                if (name != null && name in layers) out[name] = ids.copyOf(n)
+            }
+            return out
+        }
+    }
+}
