+        const int32_t *v = d.bytes;
+        NSUInteger n = d.length / sizeof(int32_t);
+        NSMutableArray *a = [NSMutableArray arrayWithCapacity:n];
+        for (NSUInteger i = 0; i < n; i++) [a addObject:@(v[i])];
+        byLayer[name] = a;
+      }
+      emit(@{@"tag" : @(self->_tag), @"z" : @(z), @"x" : @(x), @"y" : @(y), @"layers" : byLayer});
+    } @catch (NSException *ex) {
