+  if (path == nil) return nil;
+  if (![path isEqualToString:_archivePath]) {
+    [_archive close];
+    _archive = [[MLRNPmTilesIds alloc] initWithPath:path error:nil];
+    _archivePath = path;
+    [_idCache removeAllObjects];
+  }
+  return _archive;
+}
