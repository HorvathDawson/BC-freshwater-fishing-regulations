+package org.maplibre.android.maps;
+
+/**
+ * (canifishthis T452 patch) In MapLibre's package for its package-private camera cache: the binding's own glide moves the
+ * camera with {@code scrollBy} steps, which do not refresh {@code Transform}'s cached position, so the settle it reports
+ * at the end would read the position from before the glide. Pinned to MapLibre Android 13.6.1 (Transform's
+ * {@code invalidateCameraPosition}, {@code getRawZoom}, {@code setZoom(double, PointF)}, MapLibreMap's {@code getTransform}); a
+ * rename fails the build, not the app.
+ */
+public final class MLRNCameraCache {
+  private MLRNCameraCache() {}
+
+  public static void refresh(MapLibreMap map) {
+    map.getTransform().invalidateCameraPosition();
+  }
+
+  /** (canifishthis T707 patch) the zoom now, not the cached position's (MapLibre's own scale momentum reads the same) */
+  public static double zoom(MapLibreMap map) {
+    return map.getTransform().getRawZoom();
+  }
+
+  /**
+   * (canifishthis T707 patch) one frame of a pinch's carry, about its focal point: exactly what MapLibre's own scale
+   * animator does each frame ({@code Transform.setZoom(double, PointF)}: no camera-move-started, no cancel of anything).
+   */
+  public static void zoomTo(MapLibreMap map, double zoom, android.graphics.PointF focal) {
+    map.getTransform().setZoom(zoom, focal);
+  }
+}
