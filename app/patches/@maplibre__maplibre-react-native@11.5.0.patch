@@ -0,0 +1,27 @@
+#import <Foundation/Foundation.h>
+
+/**
+ * (canifishthis T217 patch) A LOCAL PMTiles archive's tiles, read for their MVT feature ids only — the iOS port of
+ * the Android half's `TileIds.kt` (same layout, same answers).
+ *
+ * MapLibre Native tells the map view's delegate WHICH tile it is requesting (`tileDidTriggerAction`) but never what is
+ * in it, so the ids are read here from the same archive the source draws (`pmtiles://file:///…`): header, directories
+ * (internal compression), the tile (tile compression), then layer name + feature id out of the protobuf — geometry
+ * and tags are skipped unread. PMTiles spec v3; MVT 2.1. Not thread-safe: one caller (the source's serial queue).
+ */
+@interface MLRNPmTilesIds : NSObject
+
+- (nullable instancetype)initWithPath:(nonnull NSString *)path error:(NSError *_Nullable *_Nullable)error;
+
+/** Layer name -> ids (NSData of int32), for the layers in `layers`; nil where the archive has no such tile. */
+- (nullable NSDictionary<NSString *, NSData *> *)idsAtZ:(NSInteger)z
+                                                      x:(NSInteger)x
+                                                      y:(NSInteger)y
+                                                 layers:(nonnull NSSet<NSString *> *)layers;
+
+- (void)close;
+
+/** The Hilbert tile id (PMTiles v3), as the JS reference `zxyToTileId` computes it. */
++ (uint64_t)tileIdForZ:(NSInteger)z x:(NSInteger)x y:(NSInteger)y;
+
+@end
diff --git a/ios/components/sources/tile-sources/vector-source/MLRNPmTilesIds.m b/ios/components/sources/tile-sources/vector-source/MLRNPmTilesIds.m
new file mode 100644
index 0000000000000000000000000000000000000000..5cb1662af13f1cf29f74d0ca0484f786dcc43280
--- /dev/null
+++ b/ios/components/sources/tile-sources/vector-source/MLRNPmTilesIds.m
@@ -0,0 +1,292 @@
+#import "MLRNPmTilesIds.h"
+
+// (canifishthis T217 patch) see the header; a line-for-line port of the Android half's TileIds.kt
+
+typedef struct {
+  const uint8_t *b;
+  NSUInteger pos;
+  NSUInteger end;
+  BOOL bad;
+} MLRNCursor;
+
+static uint64_t mlrnVarint(MLRNCursor *c) {
+  uint64_t r = 0;
+  int shift = 0;
+  while (YES) {
+    if (c->pos >= c->end || shift > 63) {
+      c->bad = YES;
+      return 0;
+    }
+    uint8_t v = c->b[c->pos++];
+    r |= ((uint64_t)(v & 0x7f)) << shift;
+    if (v < 0x80) return r;
+    shift += 7;
+  }
+}
+
+static void mlrnSkip(MLRNCursor *c, int wire) {
+  switch (wire) {
+    case 0: mlrnVarint(c); break;
+    case 1: c->pos += 8; break;
+    case 2: c->pos += (NSUInteger)mlrnVarint(c); break;
+    case 5: c->pos += 4; break;
+    default: c->bad = YES; c->pos = c->end; break;
+  }
+  if (c->pos > c->end) {
+    c->bad = YES;
+    c->pos = c->end;
+  }
+}
+
+/** gzip -> the raw DEFLATE body (RFC 1952 header and trailer off), which Compression's "zlib" algorithm inflates. */
+static NSData *mlrnGunzip(NSData *data) {
+  const uint8_t *b = data.bytes;
+  NSUInteger n = data.length;
+  if (n < 18 || b[0] != 0x1f || b[1] != 0x8b || b[2] != 8) return nil;
+  uint8_t flg = b[3];
+  NSUInteger p = 10;
+  if (flg & 4) {
+    if (p + 2 > n) return nil;
+    p += 2 + (b[p] | (b[p + 1] << 8));
+  }
+  if (flg & 8) {
+    while (p < n && b[p] != 0) p++;
+    p++;
+  }
+  if (flg & 16) {
+    while (p < n && b[p] != 0) p++;
+    p++;
+  }
+  if (flg & 2) p += 2;
+  if (p + 8 > n) return nil;
+  NSData *raw = [data subdataWithRange:NSMakeRange(p, n - p - 8)];
+  return [raw decompressedDataUsingAlgorithm:NSDataCompressionAlgorithmZlib error:nil];
+}
+
+static NSData *mlrnDecompress(NSData *b, int c) {
+  if (c == 0 || c == 1) return b;
+  if (c == 2) return mlrnGunzip(b);
+  return nil;
+}
+
+@interface MLRNPmDir : NSObject {
+ @public
+  NSUInteger n;
+  uint64_t *tileId;
+  uint64_t *offset;
+  uint32_t *length;
+  uint64_t *runLength;
+}
+@end
+
+@implementation MLRNPmDir
+- (void)dealloc {
+  free(tileId);
+  free(offset);
+  free(length);
+  free(runLength);
+}
+@end
+
+@implementation MLRNPmTilesIds {
+  NSFileHandle *_file;
+  uint64_t _rootOffset;
+  uint64_t _rootLength;
+  uint64_t _leafOffset;
+  uint64_t _tileDataOffset;
+  int _internalCompression;
+  int _tileCompression;
+  int _minZoom;
+  int _maxZoom;
+  NSCache<NSNumber *, MLRNPmDir *> *_dirs;
+}
+
+static uint64_t le64(const uint8_t *b, int o) {
+  uint64_t r = 0;
+  for (int i = 7; i >= 0; i--) r = (r << 8) | b[o + i];
+  return r;
+}
+
+- (nullable instancetype)initWithPath:(NSString *)path error:(NSError **)error {
+  if (self = [super init]) {
+    _file = [NSFileHandle fileHandleForReadingFromURL:[NSURL fileURLWithPath:path] error:error];
+    if (_file == nil) return nil;
+    NSData *h = [self read:0 length:127];
+    const uint8_t *b = h.bytes;
+    if (h.length < 127 || (b[0] | (b[1] << 8)) != 0x4D50) {
+      if (error) {
+        *error = [NSError errorWithDomain:@"MLRNTileIds"
+                                     code:1
+                                 userInfo:@{NSLocalizedDescriptionKey : [@"not a PMTiles archive: " stringByAppendingString:path]}];
+      }
+      [_file closeFile];
+      return nil;
+    }
+    _rootOffset = le64(b, 8);
+    _rootLength = le64(b, 16);
+    _leafOffset = le64(b, 40);
+    _tileDataOffset = le64(b, 56);
+    _internalCompression = b[97];
+    _tileCompression = b[98];
+    _minZoom = b[100];
+    _maxZoom = b[101];
+    _dirs = [NSCache new];
+    _dirs.countLimit = 64;
+  }
+  return self;
+}
+
+- (void)close {
+  [_file closeFile];
+}
+
+- (NSData *)read:(uint64_t)offset length:(uint64_t)length {
+  @try {
+    [_file seekToFileOffset:offset];
+    return [_file readDataOfLength:(NSUInteger)length];
+  } @catch (NSException *e) {
+    return nil;
+  }
+}
+
+- (MLRNPmDir *)dir:(uint64_t)offset length:(uint64_t)length {
+  NSNumber *key = @(offset);
+  MLRNPmDir *d = [_dirs objectForKey:key];
+  if (d) return d;
+  NSData *raw = [self read:offset length:length];
+  NSData *data = raw ? mlrnDecompress(raw, _internalCompression) : nil;
+  if (!data) return nil;
+  MLRNCursor c = {data.bytes, 0, data.length, NO};
+  NSUInteger n = (NSUInteger)mlrnVarint(&c);
+  if (c.bad || n > data.length) return nil;
+  d = [MLRNPmDir new];
+  d->n = n;
+  d->tileId = calloc(MAX(n, 1), sizeof(uint64_t));
+  d->offset = calloc(MAX(n, 1), sizeof(uint64_t));
+  d->length = calloc(MAX(n, 1), sizeof(uint32_t));
+  d->runLength = calloc(MAX(n, 1), sizeof(uint64_t));
+  uint64_t last = 0;
+  for (NSUInteger i = 0; i < n; i++) { last += mlrnVarint(&c); d->tileId[i] = last; }
+  for (NSUInteger i = 0; i < n; i++) d->runLength[i] = mlrnVarint(&c);
+  for (NSUInteger i = 0; i < n; i++) d->length[i] = (uint32_t)mlrnVarint(&c);
+  for (NSUInteger i = 0; i < n; i++) {
+    uint64_t v = mlrnVarint(&c);
+    d->offset[i] = (v == 0 && i > 0) ? d->offset[i - 1] + d->length[i - 1] : v - 1;
+  }
+  if (c.bad) return nil;
+  [_dirs setObject:d forKey:key];
+  return d;
+}
+
+static NSInteger mlrnFind(MLRNPmDir *d, uint64_t tileId) {
+  NSInteger lo = 0, hi = (NSInteger)d->n - 1;
+  while (lo <= hi) {
+    NSInteger mid = (lo + hi) / 2;
+    if (tileId > d->tileId[mid]) lo = mid + 1;
+    else if (tileId < d->tileId[mid]) hi = mid - 1;
+    else return mid;
+  }
+  if (hi >= 0 && (d->runLength[hi] == 0 || tileId - d->tileId[hi] < d->runLength[hi])) return hi;
+  return -1;
+}
+
+- (NSData *)tileAtZ:(NSInteger)z x:(NSInteger)x y:(NSInteger)y {
+  uint64_t tid = [MLRNPmTilesIds tileIdForZ:z x:x y:y];
+  uint64_t dOff = _rootOffset, dLen = _rootLength;
+  for (int depth = 0; depth <= 3; depth++) {
+    MLRNPmDir *d = [self dir:dOff length:dLen];
+    if (!d) return nil;
+    NSInteger i = mlrnFind(d, tid);
+    if (i < 0) return nil;
+    if (d->runLength[i] > 0) return [self read:_tileDataOffset + d->offset[i] length:d->length[i]];
+    dOff = _leafOffset + d->offset[i];
+    dLen = d->length[i];
+  }
+  return nil;
+}
+
+- (NSDictionary<NSString *, NSData *> *)idsAtZ:(NSInteger)z
+                                             x:(NSInteger)x
+                                             y:(NSInteger)y
+                                        layers:(NSSet<NSString *> *)layers {
+  if (z < _minZoom || z > _maxZoom) return nil;
+  NSData *raw = [self tileAtZ:z x:x y:y];
+  NSData *tile = raw ? mlrnDecompress(raw, _tileCompression) : nil;
+  if (!tile) return nil;
+  return [MLRNPmTilesIds mvtIds:tile layers:layers];
+}
+
++ (uint64_t)tileIdForZ:(NSInteger)z x:(NSInteger)x y:(NSInteger)y {
+  uint64_t acc = (((uint64_t)1 << z) * ((uint64_t)1 << z) - 1) / 3;
+  NSInteger n = z - 1;
+  int64_t tx = x, ty = y;
+  int64_t a = z == 0 ? 0 : (int64_t)1 << (z - 1);
+  while (a > 0) {
+    int64_t rx = tx & a;
+    int64_t ry = ty & a;
+    acc += (uint64_t)((3 * rx) ^ ry) * ((uint64_t)1 << n);
+    if (ry == 0) {
+      if (rx != 0) {
+        int64_t t = a - 1 - ty;
+        ty = a - 1 - tx;
+        tx = t;
+      } else {
+        int64_t t = ty;
+        ty = tx;
+        tx = t;
+      }
+    }
+    n--;
+    a >>= 1;
+  }
+  return acc;
+}
+
+/** Layer name -> feature ids (int32), for the layers asked; a feature without an id is skipped. */
++ (NSDictionary<NSString *, NSData *> *)mvtIds:(NSData *)data layers:(NSSet<NSString *> *)layers {
+  NSMutableDictionary<NSString *, NSData *> *out = [NSMutableDictionary new];
+  const uint8_t *b = data.bytes;
+  MLRNCursor t = {b, 0, data.length, NO};
+  while (t.pos < t.end && !t.bad) {
+    int key = (int)mlrnVarint(&t);
+    if ((key >> 3) != 3 || (key & 7) != 2) {
+      mlrnSkip(&t, key & 7);
+      continue;
+    }
+    NSUInteger len = (NSUInteger)mlrnVarint(&t);
+    if (t.pos + len > t.end) break;
+    MLRNCursor l = {b, t.pos, t.pos + len, NO};
+    t.pos += len;
+    NSString *name = nil;
+    NSMutableData *ids = [NSMutableData dataWithCapacity:256];
+    while (l.pos < l.end && !l.bad) {
+      int k = (int)mlrnVarint(&l);
+      if ((k >> 3) == 1 && (k & 7) == 2) {
+        NSUInteger sl = (NSUInteger)mlrnVarint(&l);
+        if (l.pos + sl > l.end) break;
+        name = [[NSString alloc] initWithBytes:b + l.pos length:sl encoding:NSUTF8StringEncoding];
+        l.pos += sl;
+      } else if ((k >> 3) == 2 && (k & 7) == 2) {
+        NSUInteger fl = (NSUInteger)mlrnVarint(&l);
+        if (l.pos + fl > l.end) break;
+        MLRNCursor f = {b, l.pos, l.pos + fl, NO};
+        l.pos += fl;
+        while (f.pos < f.end && !f.bad) {
+          int fk = (int)mlrnVarint(&f);
+          if ((fk >> 3) == 1 && (fk & 7) == 0) {
+            int32_t v = (int32_t)mlrnVarint(&f);
+            [ids appendBytes:&v length:sizeof(v)];
+            break;
+          }
+          mlrnSkip(&f, fk & 7);
+        }
+      } else {
+        mlrnSkip(&l, k & 7);
+      }
+    }
+    if (name != nil && [layers containsObject:name]) out[name] = ids;
+  }
+  return out;
+}
+
+@end
