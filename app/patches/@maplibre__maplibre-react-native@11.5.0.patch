+/*
+ * (canifishthis T217 patch) THE TILE'S IDS, AS THE TILE IS REQUESTED — the iOS half of the Android patch's
+ * `MLRNVectorSource.kt`. MapLibre Native tells the map view's delegate which tile it is requesting
+ * (`tileDidTriggerAction`, forwarded by MLRNMapView) but not what is in it; the ids are read here, off the main
+ * thread, from the source's own local PMTiles archive (`MLRNPmTilesIds`), and sent to JS as the device event
+ * `MLRNTileIds` {tag, z, x, y, layers: {name: ids[]}}.
+ */
+- (void)watchTiles:(NSArray<NSString *> *)sourceLayers
+               tag:(NSInteger)tag
+              emit:(void (^)(NSDictionary *))emit {
+  if (_reader == nil) {
+    _reader = dispatch_queue_create("org.maplibre.reactnative.TileIds", DISPATCH_QUEUE_SERIAL);
+    _idCache = [NSCache new];
+    _idCache.countLimit = 256;
+  }
+  NSSet<NSString *> *layers = [NSSet setWithArray:sourceLayers];
+  void (^e)(NSDictionary *) = [emit copy];
+  dispatch_async(_reader, ^{
+    self->_watchedLayers = layers;
+    self->_tag = tag;
+    self->_emit = e;
+    [self->_idCache removeAllObjects];
+  });
+  // on the main thread, as the requests: what was requested before the watch, as if requested now
+  NSOrderedSet<NSArray<NSNumber *> *> *early = [_early copy];
+  _early = nil;
+  for (NSArray<NSNumber *> *t in early) {
+    [self tileRequestedAtZ:t[0].integerValue x:t[1].integerValue y:t[2].integerValue];
+  }
