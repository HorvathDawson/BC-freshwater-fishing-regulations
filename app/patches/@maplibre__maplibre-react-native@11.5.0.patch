+    if (_early == nil) _early = [NSMutableOrderedSet new];
+    if (_early.count < 512) [_early addObject:@[ @(z), @(x), @(y) ]];
+    return;
+  }
+  // the source's own url; a source the style already had (no `url` prop) answers from its configuration URL
+  NSString *u = self.url;
+  if (u == nil && [self.source isKindOfClass:[MLNTileSource class]]) {
+    u = ((MLNTileSource *)self.source).configurationURL.absoluteString;
+  }
+  if (![u hasPrefix:@"pmtiles://file"]) return;
+  dispatch_async(_reader, ^{
+    NSSet<NSString *> *layers = self->_watchedLayers;
+    void (^emit)(NSDictionary *) = self->_emit;
+    if (layers.count == 0 || emit == nil) return;
+    @try {
+      NSString *key = [NSString stringWithFormat:@"%ld/%ld/%ld", (long)z, (long)x, (long)y];
+      NSDictionary<NSString *, NSData *> *ids = [self->_idCache objectForKey:key];
+      if (ids == nil) {
+        ids = [[self archiveFor:u] idsAtZ:z x:x y:y layers:layers] ?: @{};
+        [self->_idCache setObject:ids forKey:key];
+      }
