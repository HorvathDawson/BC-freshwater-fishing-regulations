+/*
+ * (canifishthis T217 patch) a stretchable image (`icon-text-fit`), the iOS half of the Android patch's stretch zones:
+ * MapLibre iOS takes a resizable image's cap insets as ONE stretch zone per axis (the part between the caps) and the
+ * same box as its content. So `stretchX`/`stretchY` (image pixels, first zone) become the cap insets; `content` has no
+ * separate form here and is the stretch box — the text sits a little further in than on Android and the web.
+ */
++ (UIImage *)stretchable:(UIImage *)img entry:(id)entry {
+  if (![entry isKindOfClass:[NSDictionary class]]) return img;
+  NSArray *sx = entry[@"stretchX"], *sy = entry[@"stretchY"];
+  if (![sx isKindOfClass:[NSArray class]] || ![sy isKindOfClass:[NSArray class]] || sx.count == 0 ||
+      sy.count == 0) {
+    return img;
+  }
+  NSArray *x = sx.firstObject, *y = sy.firstObject;
+  if (![x isKindOfClass:[NSArray class]] || ![y isKindOfClass:[NSArray class]] || x.count < 2 || y.count < 2) {
+    return img;
+  }
+  CGFloat s = img.scale > 0 ? img.scale : 1;
+  CGFloat wPx = img.size.width * s, hPx = img.size.height * s;
+  UIEdgeInsets caps = UIEdgeInsetsMake([y[0] doubleValue] / s, [x[0] doubleValue] / s,
