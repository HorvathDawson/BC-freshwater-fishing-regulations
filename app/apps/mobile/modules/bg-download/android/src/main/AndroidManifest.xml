<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- (T298) the system download manager carries the first install's big files; its notification is the system's -->
  <uses-permission android:name="android.permission.INTERNET" />
  <application>
    <!-- a tap on the download's notification opens the app (the download manager sends this to our package only) -->
    <receiver android:name="ca.canifishthis.bgdownload.NotificationClickReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.DOWNLOAD_NOTIFICATION_CLICKED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
