  "version": "0.7.8",
  "private": true,
  "license": "UNLICENSED",
  "main": "index.js",
  "scripts": {
    "web": "expo start --web --port 39218",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "export:web": "EXPO_PUBLIC_CONTACT=support@canifishthis.ca expo export --platform web --source-maps && node ../../tools/sourcemaps.mjs keep-web dist",
    "export:web:staging": "EXPO_PUBLIC_CONTACT=support@canifishthis.ca EXPO_PUBLIC_APP_ENV=staging expo export --clear --platform web --output-dir ../../dist/web-staging --source-maps && node ../../tools/sourcemaps.mjs keep-web ../../dist/web-staging"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/data": "workspace:*",
    "@app/map": "workspace:*",
    "@app/ui": "workspace:*",
    "@app/ui-native": "workspace:*",
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/metro-runtime": "58.0.15",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "58.0.19",
    "expo-background-task": "58.0.11",
    "expo-file-system": "58.0.11",
    "expo-font": "58.0.10",
    "expo-image-picker": "58.0.10",
    "expo-in-app-updates": "0.13.0",
