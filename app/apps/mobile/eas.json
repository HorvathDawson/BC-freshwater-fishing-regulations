{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_APP_ENV": "staging", "EXPO_PUBLIC_ENV_SWITCH": "1", "EXPO_PUBLIC_APP_BUILD": "dev (staging)" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_APP_ENV": "staging", "EXPO_PUBLIC_APP_BUILD": "preview (staging)" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_APP_ENV": "production" }
    }
  }
}
