{
  "expo": {
    "name": "canifishthis",
    "slug": "canifishthis",
    "version": "0.1.2",
    "icon": "./assets/icon/icon-1024.png",
    "orientation": "portrait",
    "scheme": "canifishthis",
    "platforms": ["ios", "android", "web"],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to add your photos to a spot you saved. They stay on this device.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take a photo for a spot you saved. It stays on this device.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to pin a spot where you are standing. It stays on this device.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      ["@maplibre/maplibre-react-native", { "android": { "nativeVariant": "vulkan" } }],
      "./plugins/with-upload-signing"
    ],
    "ios": {
      "bundleIdentifier": "ca.canifishthis.app",
      "supportsTablet": false,
      "buildNumber": "4"
    },
    "android": {
      "package": "ca.canifishthis.app",
      "versionCode": 4,
      "adaptiveIcon": { "foregroundImage": "./assets/icon/adaptive-foreground.png", "monochromeImage": "./assets/icon/adaptive-monochrome.png" }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon/favicon-48.png"
    }
  }
}
