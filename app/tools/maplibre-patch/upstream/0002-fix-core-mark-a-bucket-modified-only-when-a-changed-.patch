From 65bf54fbbd313ef875acea764dab6fc5c9c7c002 Mon Sep 17 00:00:00 2001
From: Dawson Horvath <horvath.dawson@gmail.com>
Date: Sat, 7 Nov 2026 02:41:52 -0700
Subject: [PATCH 2/2] fix(core): mark a bucket modified only when a changed
 feature is in it

updateVertexVectors now returns whether it rewrote a vertex; the
paint-property binders' buffer is marked modified and the bucket
re-uploaded only then. Before, every bucket on the source layer was
re-uploaded for a feature-state change, matched or not.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mln/renderer/buckets/circle_bucket.cpp    |  3 +-
 src/mln/renderer/buckets/fill_bucket.cpp      |  3 +-
 .../buckets/fill_extrusion_bucket.cpp         |  3 +-
 src/mln/renderer/buckets/line_bucket.cpp      |  3 +-
 src/mln/renderer/buckets/symbol_bucket.cpp    |  8 ++++--
 src/mln/renderer/paint_property_binder.hpp    | 28 +++++++++++++++----
 6 files changed, 31 insertions(+), 17 deletions(-)

diff --git a/src/mln/renderer/buckets/circle_bucket.cpp b/src/mln/renderer/buckets/circle_bucket.cpp
index de4f493f16..9e03ea8c2f 100644
--- a/src/mln/renderer/buckets/circle_bucket.cpp
+++ b/src/mln/renderer/buckets/circle_bucket.cpp
@@ -59,8 +59,7 @@ void CircleBucket::update(const FeatureStates& states,
                           const std::string& layerID,
                           const ImagePositions& imagePositions) {
     auto it = paintPropertyBinders.find(layerID);
-    if (it != paintPropertyBinders.end()) {
-        it->second.updateVertexVectors(states, layer, imagePositions);
+    if (it != paintPropertyBinders.end() && it->second.updateVertexVectors(states, layer, imagePositions)) {
         uploaded = false;
 
         sharedVertices->updateModified();
