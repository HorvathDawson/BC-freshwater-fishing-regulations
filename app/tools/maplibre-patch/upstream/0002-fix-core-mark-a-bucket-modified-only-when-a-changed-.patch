diff --git a/src/mln/renderer/buckets/symbol_bucket.cpp b/src/mln/renderer/buckets/symbol_bucket.cpp
index 209a6a7331..e542b89697 100644
--- a/src/mln/renderer/buckets/symbol_bucket.cpp
+++ b/src/mln/renderer/buckets/symbol_bucket.cpp
@@ -126,9 +126,11 @@ void SymbolBucket::update(const FeatureStates& states,
                           const ImagePositions& imagePositions) {
     auto it = paintProperties.find(layerID);
     if (it != paintProperties.end()) {
-        it->second.iconBinders.updateVertexVectors(states, layer, imagePositions);
-        it->second.textBinders.updateVertexVectors(states, layer, imagePositions);
-        uploaded = false;
+        const bool iconUpdated = it->second.iconBinders.updateVertexVectors(states, layer, imagePositions);
