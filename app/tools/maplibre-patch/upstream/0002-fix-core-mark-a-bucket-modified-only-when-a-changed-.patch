+        if (iconUpdated || textUpdated) {
+            uploaded = false;
+        }
     }
 }
 
diff --git a/src/mln/renderer/paint_property_binder.hpp b/src/mln/renderer/paint_property_binder.hpp
index 7aa2d74f07..b08d587f66 100644
