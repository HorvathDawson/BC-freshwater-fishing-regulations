 CHANGELOG.md                                  |   1 +
 .../vector-source-relayout/expected.png       | Bin 0 -> 39671 bytes
 .../vector-source-relayout/style.json         |  76 ++++++++++++++++++
 platform/android/CHANGELOG.md                 |   1 +
 platform/ios/CHANGELOG.md                     |   1 +
 src/mln/renderer/render_tile.cpp              |   4 +
 src/mln/renderer/render_tile.hpp              |   1 +
 src/mln/renderer/source_state.cpp             |  19 +++--
 src/mln/renderer/source_state.hpp             |   2 +
 src/mln/tile/geometry_tile.cpp                |   1 +
 src/mln/tile/tile.hpp                         |   2 +
 test/CMakeLists.txt                           |   1 +
 test/renderer/source_state.test.cpp           |  76 ++++++++++++++++++
 13 files changed, 178 insertions(+), 7 deletions(-)
 create mode 100644 metrics/integration/render-tests/feature-state/vector-source-relayout/expected.png
 create mode 100644 metrics/integration/render-tests/feature-state/vector-source-relayout/style.json
 create mode 100644 test/renderer/source_state.test.cpp

diff --git a/CHANGELOG.md b/CHANGELOG.md
index 0c0a8beafa..757d50348c 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -35,6 +35,7 @@
 ### 🐞 Bug fixes
 
 - *...Add new stuff here...*
+- [core] Apply feature state to a tile once, then only its changes, instead of re-applying the whole stored state to every rendered tile on every frame.
 - [core] Stop custom geometry tile callbacks before cancelled tiles are released on a worker thread.
 - [core] Fix rendered-feature queries near the final endpoint of an offset line.
 - [core] Fix plugin layer filters ignoring the style's global state.
diff --git a/metrics/integration/render-tests/feature-state/vector-source-relayout/expected.png b/metrics/integration/render-tests/feature-state/vector-source-relayout/expected.png
new file mode 100644
