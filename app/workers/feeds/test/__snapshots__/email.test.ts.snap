exports[`the email template > in-season: added / changed (before → after) / removed, per region > inseason.html 1`] = `"<!doctype html><html><body style="margin:0;padding:16px;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#111827"><div style="max-width:680px"><h2 style="margin:0 0 12px;font-size:18px">In-season regulation changes: 1 added, 1 changed, 1 removed — Regions 1, 4, 7B</h2><div style="margin:14px 0 4px;font-weight:600;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:#374151">Region 1</div><table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%"><tr><td style="padding:8px 0;border-top:1px solid #e5e7eb"><b>Cowichan River</b><br>No fishing upstream of Skutz Falls<br><span style="color:#6b7280;font-size:13px">was: <s>No fishing</s></span><br><span style="color:#6b7280;font-size:13px">changed · effective July 4, 2025 to August 31, 2025 → July 4, 2025 to September 15, 2025</span></td></tr></table><div style="margin:14px 0 4px;font-weight:600;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:#374151">Region 4</div><table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%"><tr><td style="padding:8px 0;border-top:1px solid #e5e7eb"><b>Elk River</b><br>No fishing September 1 to October 31, including tributaries.<br><span style="color:#6b7280;font-size:13px">added · effective October 28, 2026</span></td></tr></table><div style="margin:14px 0 4px;font-weight:600;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:#374151">Region 7B</div><table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%"><tr><td style="padding:8px 0;border-top:1px solid #e5e7eb"><b>Peace River</b><br>No fishing between Peace Canyon Dam and Hwy 29 Bridge<br><span style="color:#6b7280;font-size:13px">removed from the page · effective May 2, 2025</span></td></tr></table><div style="margin:16px 0 4px;font-weight:600">What to do</div><ol style="margin:0;padding-left:20px"><li style="margin:4px 0">Read the rows on the province's page: https://www2.gov.bc.ca/gov/content/sports-culture/recreation/fishing-hunting/fishing/fishing-regulations</li><li style="margin:4px 0">The app's in-season feed already lists them (unmatched to waters); bind any that matter in curation.</li></ol><hr style="border:0;border-top:1px solid #e5e7eb;margin:20px 0 8px"><p style="color:#6b7280;font-size:13px;margin:0">Feed status: <a href="https://bc-fishing-feeds-staging.horvath-dawson.workers.dev/status">https://bc-fishing-feeds-staging.horvath-dawson.workers.dev/status</a><br>Why you got this: The provincial in-season changes page differs from the last check. In-season changes are emailed at once.<br>Environment: <b>STAGING</b></p></div></body></html>"`;

exports[`the email template > in-season: added / changed (before → after) / removed, per region > inseason.txt 1`] = `
"In-season regulation changes: 1 added, 1 changed, 1 removed — Regions 1, 4, 7B
==============================================================================

REGION 1
  * Cowichan River
    No fishing upstream of Skutz Falls
    was: No fishing
    → changed · effective July 4, 2025 to August 31, 2025 → July 4, 2025 to
      September 15, 2025

REGION 4
  * Elk River
    No fishing September 1 to October 31, including tributaries.
    → added · effective October 28, 2026

REGION 7B
  * Peace River
    No fishing between Peace Canyon Dam and Hwy 29 Bridge
    → removed from the page · effective May 2, 2025

WHAT TO DO
  1. Read the rows on the province's page:
     https://www2.gov.bc.ca/gov/content/sports-culture/recreation/fishing-hunting/fishing/fishing-regulations
  2. The app's in-season feed already lists them (unmatched to waters); bind
     any that matter in curation.

-- 
Feed status: https://bc-fishing-feeds-staging.horvath-dawson.workers.dev/status
Why you got this: The provincial in-season changes page differs from the last
check. In-season changes are emailed at once.
Environment: STAGING
"
`;

