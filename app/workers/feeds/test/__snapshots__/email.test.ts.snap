exports[`the email template > DFO (the owner's first email, redone): every place once, in full; one queue command; no truncation > dfo.html 1`] = `"<!doctype html><html><body style="margin:0;padding:16px;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#111827"><div style="max-width:680px"><h2 style="margin:0 0 12px;font-size:18px">DFO salmon: 2 new places to place — Region 1</h2><div style="margin:14px 0 4px;font-weight:600;font-size:13px;letter-spacing:.04em;text-transform:uppercase;color:#374151">Region 1</div><table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%"><tr><td style="padding:8px 0;border-top:1px solid #e5e7eb"><b>Nanaimo River</b><br>in Subarea 17-14 (tidal portions of the Nanaimo River), that portion of the Nanaimo River from the Cedar Bridge to the white square boundary signs approximately 400 m downstream of the Cedar Bridge<br><span style="color:#6b7280;font-size:13px">1 rule held</span></td></tr><tr><td style="padding:8px 0;border-top:1px solid #e5e7eb"><b>Nanaimo River</b><br>in Subarea 17-14 (tidal portions of the Nanaimo River) from Cedar Bridge downstream<br><span style="color:#6b7280;font-size:13px">1 rule held</span></td></tr></table><div style="margin:16px 0 4px;font-weight:600">What to do</div><ol style="margin:0;padding-left:20px"><li style="margin:4px 0">Queue the new rows for review:<br><code style="display:inline-block;margin-top:4px;padding:4px 6px;background:#f3f4f6;border-radius:4px;font-size:13px">python -m pipeline.regs.dfo_salmon.live queue --regions 1</code></li><li style="margin:4px 0">Review app → DFO → Extents: Nanaimo River (2 places)</li></ol><hr style="border:0;border-top:1px solid #e5e7eb;margin:20px 0 8px"><p style="color:#6b7280;font-size:13px;margin:0">Feed status: <a href="https://bc-fishing-feeds-staging.horvath-dawson.workers.dev/status">https://bc-fishing-feeds-staging.horvath-dawson.workers.dev/status</a><br>Why you got this: DFO's salmon pages changed in a way the feed will not publish on its own (new or reworded places, or a held region). DFO items are emailed at once.<br>Environment: <b>STAGING</b></p></div></body></html>"`;

exports[`the email template > DFO (the owner's first email, redone): every place once, in full; one queue command; no truncation > dfo.txt 1`] = `
"DFO salmon: 2 new places to place — Region 1
============================================

REGION 1
  * Nanaimo River
    in Subarea 17-14 (tidal portions of the Nanaimo River), that portion of
    the Nanaimo River from the Cedar Bridge to the white square boundary signs
    approximately 400 m downstream of the Cedar Bridge
    → 1 rule held
  * Nanaimo River
    in Subarea 17-14 (tidal portions of the Nanaimo River) from Cedar Bridge
    downstream
    → 1 rule held

WHAT TO DO
  1. Queue the new rows for review:
       python -m pipeline.regs.dfo_salmon.live queue --regions 1
  2. Review app → DFO → Extents: Nanaimo River (2 places)

-- 
Feed status: https://bc-fishing-feeds-staging.horvath-dawson.workers.dev/status
Why you got this: DFO's salmon pages changed in a way the feed will not
publish on its own (new or reworded places, or a held region). DFO items are
emailed at once.
Environment: STAGING
"
`;

